{
  // Cloudflare Worker config for the Rendile Travels site.
  // No server-side code — this is an "assets-only" Worker that serves the
  // static HTML/CSS/JS/images Astro produces.
  //
  // Deploy flow:  npm run build   (compiles src/ -> dist/)
  //               npx wrangler deploy   (publishes dist/)
  "name": "rendile-travels",
  "compatibility_date": "2025-06-25",
  "assets": {
    // Astro's build output. Run `npm run build` first.
    "directory": "./dist"
  }
}

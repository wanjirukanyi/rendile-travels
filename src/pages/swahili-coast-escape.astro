---
import Base from '../layouts/BaseLayout.astro';
---
<Base
  title={`Swahili Coast Escape | 3 Day Beach Weekend | Rendile Travels`}
  description={`A 3 day Swahili coast beach escape for those living in East Africa, fly to the Indian Ocean for dhow sails, snorkelling and Swahili feasts. Day by day itinerary and prices from $890.`}
  ogTitle={`Swahili Coast Escape | 3 Day Beach Weekend | Rendile Travels`}
  ogDescription={`A barefoot weekend on the Indian Ocean, dhows, snorkelling and Swahili food. 3 days from $890.`}
  ogType={`website`}
  ogImage={`assets/img/kenya-lamu.jpg`}
  canonical={`https://rendiletravels.com/swahili-coast-escape.html`}
  jsonld={`{"@context":"https://schema.org","@type":"TouristTrip","name":"Swahili Coast Escape — 3-Day Beach Weekend","description":"A 3-day Swahili coast beach escape with dhow sails, snorkelling and Swahili food.","image":"https://rendiletravels.com/assets/img/kenya-lamu.jpg","provider":{"@type":"Organization","name":"Rendile Travels"},"offers":{"@type":"Offer","price":"890","priceCurrency":"USD"}}`}
  credit={`Imagery via Wikimedia Commons &amp; Pexels, licensed under <a href="https://creativecommons.org/licenses/by/4.0" target="_blank" rel="license noopener">CC BY</a> / <a href="https://creativecommons.org/licenses/by-sa/4.0" target="_blank" rel="license noopener">CC BY-SA</a>.`}
>

<section class="page-hero">
    <div class="page-hero__media" style="background-image:url('assets/img/kenya-lamu.jpg')"></div>
    <div class="page-hero__scrim"></div>
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--light reveal">Quick escape · Itinerary</p>
      <h1 class="reveal">Swahili Coast Escape</h1>
      <div class="itin-meta reveal">
        <span><b>3 days · 2 nights</b></span>
        <span>Swahili Coast · Beach</span>
        <span>Resident rates available</span>
        <span>from <b>$890</b> / person</span>
      </div>
      <div class="hero__actions reveal" style="margin-top:1.6rem"><a href="contact.html?trip=Swahili%20Coast%20Escape" class="btn btn--gold">Enquire about this escape</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="article reveal">
        <nav class="breadcrumb"><a href="index.html">Home</a> / <a href="index.html#experiences">Quick escapes</a> / Swahili Coast Escape</nav>
        <p class="article__lead">Trade the city for the Indian Ocean for a long weekend. Fly to the Swahili coast, swap your shoes for the sand, and let two nights of dhow sails, warm water and spice scented feasts slow everything right down.</p>
        <p>Designed for residents and short stay travellers, with easy fly in logistics and resident rates. We tailor it to Diani, Lamu or Watamu to suit your taste.</p>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">Day by day</p><h2 class="section__title">Your weekend</h2></div>
      <div class="days">
        <div class="day reveal"><div class="day__num">Fri</div><div class="day__body"><h3>Fly to the coast</h3><p>A short flight to the coast, then straight to your beachfront retreat. Toes in the sand, a swim, and a sunset cocktail to begin.</p><p class="day__stay"><b>Stay:</b> Beachfront hotel · <b>Meals:</b> Dinner</p></div></div>
        <div class="day reveal"><div class="day__num">Sat</div><div class="day__body"><h3>Ocean day</h3><p>A traditional dhow cruise with snorkelling over the reef and a fresh seafood lunch on the water, then a free afternoon to laze, read or take a spa treatment.</p><p class="day__stay"><b>Stay:</b> Beachfront hotel · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Sun</div><div class="day__body"><h3>Morning &amp; fly home</h3><p>A last slow morning by the sea, a swim, a long breakfast, then transfer to the airstrip for your flight home.</p><p class="day__stay"><b>Meals:</b> Breakfast</p></div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="incl reveal">
        <div class="section__head section__head--left"><p class="eyebrow">All taken care of</p><h2 class="section__title">What's included</h2></div>
        <ul class="incl__grid">
          <li>Return flights to the coast</li>
          <li>Two nights at a beachfront hotel</li>
          <li>Breakfast daily &amp; meals as shown</li>
          <li>Private dhow cruise &amp; snorkelling</li>
          <li>All airport transfers</li>
          <li>24/7 Rendile concierge</li>
        </ul>
        <p style="margin-top:1.2rem;color:var(--ink-soft)">From <strong>$890 per person sharing</strong>; <strong>special resident rates available</strong>. Spa treatments and additional excursions are extra. Easily extended; the coast is sunniest June to October &amp; December to February.</p>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container reveal"><h2>Sun, sand &amp; dhows.</h2><p>Tell us your dates and which beach you fancy, and we'll set it up, resident rates included.</p><a href="contact.html?trip=Swahili%20Coast%20Escape" class="btn btn--gold">Enquire about this escape</a></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">More escapes</p><h2 class="section__title">Other quick escapes</h2></div>
      <div class="related__grid reveal">
        <a class="feat" href="weekend-mara.html"><div class="feat__img" style="background-image:url('assets/img/kenya-cheetah.jpg')"></div><div class="feat__body"><h3>A Weekend in the Mara</h3><p>3 days · fly in safari.</p></div></a>
        <a class="feat" href="gorillas-in-a-weekend.html"><div class="feat__img" style="background-image:url('assets/img/rw-volcanoes.jpg')"></div><div class="feat__body"><h3>Gorillas in a Weekend</h3><p>3 days · fly in trek.</p></div></a>
        <a class="feat" href="zanzibar-womens-retreat.html"><div class="feat__img" style="background-image:url('assets/img/trip-zanzibar.jpg')"></div><div class="feat__body"><h3>Zanzibar Women's Retreat</h3><p>7 days · women only wellness.</p></div></a>
      </div>
    </div>
  </section>

</Base>

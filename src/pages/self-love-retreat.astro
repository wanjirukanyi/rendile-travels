---
import Base from '../layouts/BaseLayout.astro';
const trip = "The Self-Love Retreat (February 2027)";
const enquire = `contact.html?trip=${encodeURIComponent(trip)}`;
---
<Base
  title={`The Self-Love Retreat — Women's Wellness Retreat in Zanzibar | Rendile Travels`}
  description={`A 7-day self-love and self-care retreat for 10 women on Zanzibar, 9–15 February 2027, over Galentine's and Valentine's weekend. Spa rituals, yoga, journaling circles, a dhow sail and a beach dinner. From $4,200.`}
  ogTitle={`The Self-Love Retreat — Zanzibar, February 2027 | Rendile Travels`}
  ogDescription={`This February, choose yourself. Ten women, seven days of rest and self-care on Zanzibar. 9–15 Feb 2027, from $4,200.`}
  ogType={`website`}
  ogImage={`assets/img/self-love-hero.jpg`}
  canonical={`https://rendiletravels.com/self-love-retreat.html`}
  keywords={`self-love retreat, women's retreat Zanzibar, Galentine's trip, Valentine's retreat for women, wellness retreat Zanzibar, women's wellness retreat Africa`}
  jsonld={`{"@context":"https://schema.org","@type":"TouristTrip","name":"The Self-Love Retreat — Zanzibar","description":"A 7-day self-love and self-care retreat for ten women on Zanzibar over Galentine's and Valentine's weekend.","image":"https://rendiletravels.com/assets/img/self-love-hero.jpg","touristType":"Women","provider":{"@type":"Organization","name":"Rendile Travels"},"offers":{"@type":"Offer","price":"4200","priceCurrency":"USD","availability":"https://schema.org/LimitedAvailability","validFrom":"2026-11-01"}}`}
  credit={`Photography via Pexels.`}
>

  <section class="page-hero">
    <div class="page-hero__media" style="background-image:url('assets/img/self-love-hero.jpg');background-position:center 22%"></div>
    <div class="page-hero__scrim"></div>
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--light reveal">February 2027 · Africa retreat</p>
      <h1 class="reveal">The Self-Love Retreat</h1>
      <p class="page-hero__sub reveal">Seven days of rest, ritual &amp; sisterhood on Zanzibar</p>
      <div class="itin-meta reveal">
        <span><b>9–15 Feb 2027</b></span>
        <span>7 days</span>
        <span>Stone Town · East Coast</span>
        <span>10 women only</span>
        <span>from <b>$4,200</b> / person</span>
      </div>
      <div class="hero__actions reveal" style="margin-top:1.6rem"><a href={enquire} class="btn btn--gold">Reserve your place</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="article reveal">
        <nav class="breadcrumb"><a href="index.html">Home</a> / <a href="index.html#calendar">2027 retreats</a> / The Self-Love Retreat</nav>
        <p class="article__lead">This February, the love story is yours. Spend Galentine's and Valentine's weekend on the white sands of Zanzibar with nine other women: slow mornings, ocean swims, spa rituals and honest conversations about how to treat yourself the way you treat the people you love.</p>
        <p>It's a gentle week, not a programme to keep up with. Every session is an invitation, never an obligation, and there's always time to simply lie in the shade with a book. Come alone, with your best friend, your sister or your mum.</p>
      </div>
    </div>
  </section>

  <section class="section section--cream pillars">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">The theme</p><h2 class="section__title">Rest. Ritual. Reconnect.</h2></div>
      <div class="pillars__grid">
        <article class="pillar reveal">
          <span class="pillar__num">01</span>
          <h3>Rest, properly</h3>
          <p>No alarms, no rush. Beachfront rooms, long lunches, ocean swims and permission to do nothing at all. Sleep is part of the programme.</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__num">02</span>
          <h3>Rituals of care</h3>
          <p>Swahili beauty rituals with coconut, spice and henna, a spa day, daily yoga and meditation, and a joyful photo shoot with a female photographer.</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__num">03</span>
          <h3>Come back to you</h3>
          <p>Journaling circles and a self-compassion workshop with a women's wellbeing coach, plus a love letter to yourself that we post to you three months later.</p>
        </article>
      </div>
    </div>
  </section>

    <section class="section">
    <div class="container">
      <div class="gallery__grid reveal">
        <img src="assets/img/sl-robes.jpg" alt="Two women in spa robes" loading="lazy" />
        <img src="assets/img/sl-massage.jpg" alt="A woman enjoying a massage" loading="lazy" />
        <img src="assets/img/sl-yoga.jpg" alt="A woman doing yoga on the beach at sunset" loading="lazy" />
        <img src="assets/img/sl-dinner.jpg" alt="Women sharing dinner together" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">Day by day</p><h2 class="section__title">Your 7-day retreat</h2></div>
      <div class="days">
        <div class="day reveal"><div class="day__num">Day 1<br/>Tue 9</div><div class="day__body"><h3>Karibu Zanzibar</h3><p>Met at the airport and taken into historic Stone Town. Settle into a boutique hotel, then meet the group for a welcome dinner on a rooftop as the sun sets over the harbour.</p><p class="day__stay"><b>Stay:</b> Stone Town boutique hotel · <b>Meals:</b> Dinner</p></div></div>
        <div class="day reveal"><div class="day__num">Day 2<br/>Wed 10</div><div class="day__body"><h3>Spice, scent &amp; Stone Town</h3><p>A slow morning walk through the UNESCO old town's carved doors and markets, then a spice farm, where you'll blend your own body oil, and a Swahili cooking lunch.</p><p class="day__stay"><b>Stay:</b> Stone Town boutique hotel · <b>Meals:</b> Breakfast, lunch</p></div></div>
        <div class="day reveal"><div class="day__num">Day 3<br/>Thu 11</div><div class="day__body"><h3>To the ocean</h3><p>Transfer to the turquoise east coast and your beachfront retreat. Sunset yoga on the sand, then the first journaling circle: "what does loving myself actually look like?"</p><p class="day__stay"><b>Stay:</b> Beachfront resort · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Day 4<br/>Fri 12</div><div class="day__body"><h3>Spa day &amp; Swahili beauty rituals</h3><p>A full day of care: coconut and clove scrubs, a massage, henna with a local artist, and a relaxed photo shoot on the beach with a female photographer. Just for you, never for social media unless you want it to be.</p><p class="day__stay"><b>Stay:</b> Beachfront resort · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Day 5<br/>Sat 13</div><div class="day__body"><h3>Galentine's Day at sea</h3><p>A day on a traditional dhow: snorkelling, a sandbank picnic and a slow sail home at sunset. In the evening, a Galentine's dinner on the beach, celebrating the women in our lives.</p><p class="day__stay"><b>Stay:</b> Beachfront resort · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Day 6<br/>Sun 14</div><div class="day__body"><h3>Valentine's Day, for you</h3><p>Morning meditation and a self-compassion workshop, then write your love letter to yourself. The afternoon is free. The evening is a candlelit "celebration of you" dinner.</p><p class="day__stay"><b>Stay:</b> Beachfront resort · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Day 7<br/>Mon 15</div><div class="day__body"><h3>Go gently</h3><p>A last sunrise swim and closing circle, then a transfer to the airport for your onward flight, softer, rested and a little more on your own side.</p><p class="day__stay"><b>Meals:</b> Breakfast</p></div></div>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="incl reveal">
        <div class="section__head section__head--left"><p class="eyebrow">All taken care of</p><h2 class="section__title">What's included</h2></div>
        <ul class="incl__grid">
          <li>2 nights in a Stone Town boutique hotel</li>
          <li>4 nights in a beachfront resort, all meals</li>
          <li>All airport &amp; island transfers</li>
          <li>Daily yoga &amp; meditation</li>
          <li>Journaling circles &amp; a self-compassion workshop</li>
          <li>Spa day: scrub, massage &amp; henna</li>
          <li>Beach photo shoot with a female photographer</li>
          <li>Stone Town walk, spice farm &amp; cooking lunch</li>
          <li>Private dhow day, snorkelling &amp; sandbank picnic</li>
          <li>Galentine's &amp; Valentine's dinners on the beach</li>
          <li>Female Rendile host throughout &amp; all gratuities</li>
        </ul>
        <p style="margin-top:1.2rem;color:var(--ink-soft)">From <strong>$4,200 per person sharing</strong>; single-room supplement available. International flights, visas and travel insurance are not included. Just <strong>10 places</strong>, held on a first-come basis.</p>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container reveal"><h2>This February, choose yourself.</h2><p>Ten places, seven days on the Indian Ocean. Tell us a little about you and we'll hold your place.</p><a href={enquire} class="btn btn--gold">Reserve your place</a></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">On the calendar</p><h2 class="section__title">More 2027 retreats</h2></div>
      <div class="related__grid reveal">
        <a class="feat" href="new-year-new-you.html"><div class="feat__img" style="background-image:url('assets/img/retreat-yoga.jpg')"></div><div class="feat__body"><h3>January · New Year, New You</h3><p>Plan your year under Mount Kenya.</p></div></a>
        <a class="feat" href="index.html#calendar"><div class="feat__img" style="background-image:url('assets/img/cal-mar.jpg')"></div><div class="feat__body"><h3>March · Women's Month Safari</h3><p>Celebrate International Women's Day in the Maasai Mara.</p></div></a>
        <a class="feat" href="index.html#calendar"><div class="feat__img" style="background-image:url('assets/img/cal-apr.jpg')"></div><div class="feat__body"><h3>The full 2027 calendar</h3><p>One themed retreat a month, ten women each.</p></div></a>
      </div>
    </div>
  </section>

</Base>

<Base
  title={`Gorillas in a Weekend — 3-Day Fly-In Gorilla Trek | Rendile Travels`}
  description={`A 3-day fly-in gorilla trekking weekend in Rwanda's Volcanoes National Park — ideal for those living in East Africa. Permit, lodge and transfers included. Day-by-day itinerary and prices from $2,400.`}
  ogTitle={`Gorillas in a Weekend — 3-Day Fly-In Gorilla Trek | Rendile Travels`}
  ogDescription={`Fly in for one unforgettable hour with the mountain gorillas, home by Sunday. 3 days from $2,400.`}
  ogType={`website`}
  ogImage={`assets/img/rw-volcanoes.jpg`}
  canonical={`https://rendiletravels.com/gorillas-in-a-weekend.html`}
  jsonld={`{"@context":"https://schema.org","@type":"TouristTrip","name":"Gorillas in a Weekend — 3-Day Fly-In Gorilla Trek","description":"A 3-day fly-in gorilla trekking weekend in Rwanda's Volcanoes National Park.","image":"https://rendiletravels.com/assets/img/rw-volcanoes.jpg","provider":{"@type":"Organization","name":"Rendile Travels"},"offers":{"@type":"Offer","price":"2400","priceCurrency":"USD"}}`}

---
import Base from '../layouts/BaseLayout.astro';
const trip = "New Year, New You (January 2027)";
const enquire = `contact.html?trip=${encodeURIComponent(trip)}`;
---
<Base
  title={`New Year, New You | Women's Goal Setting & Wellness Retreat, Kenya | Rendile Travels`}
  description={`A 6 day goal setting and wellness retreat for women under Mount Kenya, 10 to 15 January 2027. Guided planning workshops, vision boards, coaching, yoga, spa and a rhino safari. From $3,900.`}
  ogTitle={`New Year, New You | a women's retreat to plan your year | Rendile Travels`}
  ogDescription={`Six days under Mount Kenya with a small group of women: plan your year with a coach, then nourish body and mind. 10 to 15 January 2027, from $3,900.`}
  ogType={`website`}
  ogImage={`assets/img/new-year-hero.jpg?v=3`}
  canonical={`https://rendiletravels.com/new-year-new-you.html`}
  keywords={`women's retreat Kenya, new year retreat, goal setting retreat for women, vision board retreat, wellness retreat Nanyuki, women's wellness retreat Africa`}
  jsonld={`{"@context":"https://schema.org","@type":"TouristTrip","name":"New Year, New You — Women's Goal-Setting & Wellness Retreat","description":"A 6-day goal-setting and wellness retreat for women in Laikipia, Kenya, under Mount Kenya.","image":"https://rendiletravels.com/assets/img/new-year-hero.jpg?v=3","touristType":"Women","provider":{"@type":"Organization","name":"Rendile Travels"},"offers":{"@type":"Offer","price":"3900","priceCurrency":"USD","availability":"https://schema.org/LimitedAvailability","validFrom":"2026-11-01"}}`}
  credit={`Photography via Pexels.`}
>

  <section class="page-hero">
    <div class="page-hero__media" style="background-image:url('assets/img/new-year-hero.jpg?v=3');background-position:center 31%"></div>
    <div class="page-hero__scrim"></div>
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--light reveal">January 2027 · Africa retreat</p>
      <h1 class="reveal">New Year, New You</h1>
      <p class="page-hero__sub reveal">A goal setting &amp; wellness retreat under Mount Kenya</p>
      <div class="itin-meta reveal">
        <span><b>10 to 15 Jan 2027</b></span>
        <span>6 days</span>
        <span>Nanyuki, Kenya</span>
        <span>Women only</span>
        <span>from <b>$3,900</b> / person</span>
      </div>
      <div class="hero__actions reveal" style="margin-top:1.6rem"><a href={enquire} class="btn btn--gold">Reserve your place</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="article reveal">
        <nav class="breadcrumb"><a href="index.html">Home</a> / <a href="index.html#calendar">2027 retreats</a> / New Year, New You</nav>
        <p class="article__lead">Start the year with intention, not resolutions. Over six days on a private conservancy in the Laikipia highlands, a small group of women look back on the year that was, decide what the next one is for, and leave with a clear, personal plan to make it happen.</p>
        <p>Mornings are for the work: guided reflection, vision boarding and goal setting with a certified life coach. Afternoons are for the body: yoga, breathwork, spa treatments, nourishing food and the wide open space of the savanna, with Mount Kenya on the horizon and rhinos a short drive away.</p>
        <p>You don't need to arrive with answers. You just need to come.</p>
      </div>
    </div>
  </section>

  <section class="section section--cream pillars">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">The theme</p><h2 class="section__title">Reflect. Dream. Plan. Nourish.</h2></div>
      <div class="pillars__grid">
        <article class="pillar reveal">
          <span class="pillar__num">01</span>
          <h3>Plan the year</h3>
          <p>Guided workshops to review last year, set your priorities and build a 12 month plan with quarterly goals and the habits to support them. Plus a private one to one coaching session.</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__num">02</span>
          <h3>Restore your body</h3>
          <p>Daily sunrise yoga, breathwork, a sound bath, a spa treatment and a nutrition session with the lodge chef, so your plan starts with a rested, nourished you.</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__num">03</span>
          <h3>Leave with a circle</h3>
          <p>You'll be paired with an accountability partner, and the group meets online every month from February to April to check in, celebrate wins and keep each other on track.</p>
        </article>
      </div>
    </div>
  </section>

    <section class="section">
    <div class="container">
      <div class="gallery__grid reveal">
        <img src="assets/img/ny-vision.jpg" alt="A woman pinning ideas to a vision board" loading="lazy" />
        <img src="assets/img/ny-journal.jpg" alt="A woman writing her goals in a journal" loading="lazy" />
        <img src="assets/img/ny-meditate.jpg" alt="A woman meditating outdoors" loading="lazy" />
        <img src="assets/img/ny-spa.jpg" alt="Two women relaxing in robes at the spa" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">Day by day</p><h2 class="section__title">Your 6 day retreat</h2></div>
      <div class="days">
        <div class="day reveal"><div class="day__num">Day 1<br/>Sun 10</div><div class="day__body"><h3>Arrive &amp; set your intention</h3><p>Met in Nairobi and flown (or driven) north to Nanyuki. Settle into your room with Mount Kenya views, then gather around the fire for a welcome circle: meet the other women and set one intention for the week.</p><p class="day__stay"><b>Stay:</b> Luxury lodge, Laikipia · <b>Meals:</b> Lunch, dinner</p></div></div>
        <div class="day reveal"><div class="day__num">Day 2<br/>Mon 11</div><div class="day__body"><h3>Reflect: look back to move forward</h3><p>Sunrise yoga, then the first workshop: your year in review. Wins, lessons, and what you're ready to let go of. A spa treatment in the afternoon, and an evening fire ritual to release what you're leaving behind.</p><p class="day__stay"><b>Stay:</b> Luxury lodge · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Day 3<br/>Tue 12</div><div class="day__body"><h3>Dream: your vision for the year</h3><p>A values and "wheel of life" session, then a vision board workshop with everything you need provided. In the afternoon, a game drive in Ol Pejeta Conservancy, home of the last two northern white rhinos, ending with sundowners on the plains.</p><p class="day__stay"><b>Stay:</b> Luxury lodge · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Day 4<br/>Wed 13</div><div class="day__body"><h3>Plan: from vision to 12 months</h3><p>The core workshop: turn your vision into goals, quarterly milestones and weekly habits in your Rendile 2027 planner. Each woman has a private one to one coaching session. Later, a golden hour horseback ride across the Laikipia plains, or a nutrition and cooking session with the chef.</p><p class="day__stay"><b>Stay:</b> Luxury lodge · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Day 5<br/>Thu 14</div><div class="day__body"><h3>Nourish &amp; celebrate</h3><p>An early walk in the Mount Kenya foothills, then breathwork and a sound bath. Free afternoon by the pool. At the farewell dinner, each woman shares her "word of the year" and meets her accountability partner.</p><p class="day__stay"><b>Stay:</b> Luxury lodge · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Day 6<br/>Fri 15</div><div class="day__body"><h3>Go and make it happen</h3><p>A last sunrise practice and a short closing circle, then back to Nairobi for your onward flight, with a plan in your bag and new friends in your phone.</p><p class="day__stay"><b>Meals:</b> Breakfast</p></div></div>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="incl reveal">
        <div class="section__head section__head--left"><p class="eyebrow">All taken care of</p><h2 class="section__title">What's included</h2></div>
        <ul class="incl__grid">
          <li>5 nights in a luxury lodge in Laikipia, all meals</li>
          <li>Return Nairobi to Nanyuki transfers or scheduled flights</li>
          <li>4 guided goal setting workshops with a certified life coach</li>
          <li>A private one to one coaching session</li>
          <li>Your Rendile 2027 planner &amp; vision board kit</li>
          <li>Daily yoga, breathwork &amp; a sound bath</li>
          <li>One spa treatment per guest</li>
          <li>Ol Pejeta game drive &amp; conservancy fees</li>
          <li>A golden hour horseback ride in Laikipia</li>
          <li>Monthly online check ins, February to April</li>
          <li>Female Rendile host throughout &amp; all gratuities</li>
        </ul>
        <p style="margin-top:1.2rem;color:var(--ink-soft)">From <strong>$3,900 per person sharing</strong>; single room supplement available. International flights, visas and travel insurance are not included. Places are limited and held on a first come basis.</p>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container reveal"><h2>Your year starts here.</h2><p>Limited places, six days under Mount Kenya. Tell us a little about you and we'll hold your place.</p><a href={enquire} class="btn btn--gold">Reserve your place</a></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">Next on the calendar</p><h2 class="section__title">More 2027 retreats</h2></div>
      <div class="related__grid reveal">
        <a class="feat" href="self-love-retreat.html"><div class="feat__img" style="background-image:url('assets/img/cal-feb.jpg?v=3')"></div><div class="feat__body"><h3>February · The Self Love Retreat</h3><p>7 days of rest and self care on Zanzibar.</p></div></a>
        <a class="feat" href="index.html#calendar"><div class="feat__img" style="background-image:url('assets/img/cal-mar.jpg?v=3')"></div><div class="feat__body"><h3>March · Women's Month Safari</h3><p>Celebrate International Women's Day in the Maasai Mara.</p></div></a>
        <a class="feat" href="index.html#calendar"><div class="feat__img" style="background-image:url('assets/img/cal-apr.jpg')"></div><div class="feat__body"><h3>The full 2027 calendar</h3><p>Themed retreats to rest, reconnect and rise.</p></div></a>
      </div>
    </div>
  </section>

</Base>

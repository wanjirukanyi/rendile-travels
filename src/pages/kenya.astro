---
import Base from '../layouts/BaseLayout.astro';
---
<Base
  title={`Kenya — Safaris & Itineraries | Rendile Travels`}
  description={`Kenya itineraries for women — the Maasai Mara, Amboseli beneath Kilimanjaro, the Great Migration and the Swahili coast. Tailor-made luxury journeys, curated end to end by Rendile Travels.`}
  ogTitle={`Kenya — Safaris & Itineraries | Rendile Travels`}
  ogType={`website`}
  ogImage={`assets/logo-orange.png`}
  credit={`Imagery via Wikimedia Commons &amp; Pexels. Balloon © Svein-Magne Tunli; Maasai Mara sunset © Daniel Case. Licensed under <a href="https://creativecommons.org/licenses/by-sa/4.0" target="_blank" rel="license noopener">CC BY-SA 4.0</a>.`}
  announce
>

<!-- Page hero -->
  <section class="page-hero">
    <div class="page-hero__media" style="background-image:url('assets/img/kenya-hero.jpg')"></div>
    <div class="page-hero__scrim"></div>
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--light reveal">Destination</p>
      <h1 class="reveal">Kenya</h1>
      <p class="page-hero__sub reveal">The birthplace of safari.</p>
    </div>
  </section>

  <!-- Itineraries (lead) -->
  <section class="section journeys" id="itineraries">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Kenya itineraries</p>
        <h2 class="section__title">Journeys through Kenya</h2>
        <p class="section__intro">Starting points, not fixed menus — every itinerary is reshaped entirely around you, your pace and your people.</p>
      </div>

      <div class="journeys__grid">
        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/kenya-amboseli.jpg')">
            <span class="journey__tag">Mara · Amboseli · Nakuru</span>
          </div>
          <div class="journey__body">
            <h3>Classic Kenya Safari</h3>
            <p class="journey__meta">8 days · Private &amp; tailor-made</p>
            <p>The icons in one seamless journey — big cats in the Maasai Mara, elephants beneath Kilimanjaro, and the flamingo-pink lakes of the Rift Valley.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$7,900</strong> <em>/ person</em></span>
              <a href="classic-kenya-safari.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/kenya-migration.jpg')">
            <span class="journey__tag">Maasai Mara · Jul–Oct</span>
          </div>
          <div class="journey__body">
            <h3>The Great Migration</h3>
            <p class="journey__meta">6 days · Private or small-group</p>
            <p>Front-row seats to the world's greatest wildlife spectacle, from hand-picked tented camps right on the migration's path.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$6,800</strong> <em>/ person</em></span>
              <a href="great-migration.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/trip-family.jpg')">
            <span class="journey__tag">Mara · Nairobi · Family</span>
          </div>
          <div class="journey__body">
            <h3>Mummy and Me Safari</h3>
            <p class="journey__meta">5 days · Mothers &amp; children</p>
            <p>A gentle family adventure where mothers and children bond over wildlife encounters, bush walks and starlit stories.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$4,900</strong> <em>/ person</em></span>
              <a href="mummy-and-me-safari.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/trip-lamu.jpg')">
            <span class="journey__tag">Lamu, Kenya · Wellness</span>
          </div>
          <div class="journey__body">
            <h3>Lamu Yoga Festival</h3>
            <p class="journey__meta">5 days · Women &amp; men · adults only</p>
            <p>Kenya's beloved Lamu Yoga &amp; Wellbeing Festival on the Swahili coast — beachfront yoga, dhow cruises and Swahili feasts.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$5,600</strong> <em>/ person</em></span>
              <a href="lamu-yoga-festival.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/kenya-cheetah.jpg')">
            <span class="journey__tag">Maasai Mara · The Coast</span>
          </div>
          <div class="journey__body">
            <h3>Savanna to Sea</h3>
            <p class="journey__meta">10 days · Safari &amp; beach</p>
            <p>Big-cat country in the Mara, then barefoot days on the Indian Ocean — the perfect first, full taste of Kenya.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$9,400</strong> <em>/ person</em></span>
              <a href="savanna-to-sea.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/kenya-giraffe.jpg')">
            <span class="journey__tag">Mara · Amboseli · Women-only</span>
          </div>
          <div class="journey__body">
            <h3>Women-Only Kenya Highlights</h3>
            <p class="journey__meta">8 days · Hosted group of 8–12</p>
            <p>Our flagship sisterhood departure — the Mara, Amboseli and Nairobi with a female host, vetted camps and like-minded women.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$8,200</strong> <em>/ person</em></span>
              <a href="women-only-kenya.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>
      </div>

      <div class="journeys__cta reveal">
        <a href="contact.html" class="btn btn--gold">Design your own Kenya journey</a>
      </div>
    </div>
  </section>

  <!-- Why Kenya -->
  <section class="section section--cream">
    <div class="container">
      <div class="prose reveal">
        <p class="eyebrow">Why Kenya</p>
        <h2 class="section__title">Where safari was born.</h2>
        <p>Kenya is where the word <em>safari</em> began — and it still does it best. In one journey you can drift over the Maasai Mara at dawn in a hot-air balloon, watch elephants graze beneath Mount Kilimanjaro, and end with your toes in the warm Indian Ocean.</p>
        <p>For women travelling with us, Kenya is also wonderfully easy: superb camps, warm hospitality, female guides where possible, and a Rendile team on the ground every step of the way.</p>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Where to go</p>
        <h2 class="section__title">Kenya's highlights</h2>
      </div>
      <div class="feat__grid">
        <a class="feat reveal" href="maasai-mara.html">
          <div class="feat__img" style="background-image:url('assets/img/kenya-cheetah.jpg')"></div>
          <div class="feat__body"><h3>Maasai Mara</h3><p>Big cats, endless plains and the Great Migration river crossings (Jul–Oct).</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="amboseli.html">
          <div class="feat__img" style="background-image:url('assets/img/kenya-amboseli.jpg')"></div>
          <div class="feat__body"><h3>Amboseli</h3><p>Great herds of elephants framed by the snows of Mount Kilimanjaro.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="lake-nakuru.html">
          <div class="feat__img" style="background-image:url('assets/img/kenya-nakuru.jpg')"></div>
          <div class="feat__body"><h3>Lake Nakuru &amp; the Rift</h3><p>Flamingo-pink shorelines, rhino and the drama of the Great Rift Valley.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="samburu.html">
          <div class="feat__img" style="background-image:url('assets/img/kenya-samburu.jpg')"></div>
          <div class="feat__body"><h3>Samburu</h3><p>Wild, arid north — rare species and the proud Samburu, cousins of the Maasai.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="lamu-coast.html">
          <div class="feat__img" style="background-image:url('assets/img/kenya-lamu.jpg')"></div>
          <div class="feat__body"><h3>Lamu &amp; the Coast</h3><p>Swahili old towns, dhow sails and barefoot beaches on the Indian Ocean.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="nairobi.html">
          <div class="feat__img" style="background-image:url('assets/img/kenya-nairobi.jpg')"></div>
          <div class="feat__body"><h3>Nairobi &amp; Giraffe Manor</h3><p>Breakfast with giraffes, elephant orphanage mornings and the city's creative pulse.</p><span class="feat__more">Read more →</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- Best time -->
  <section class="section section--cream">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">When to go</p>
        <h2 class="section__title">Best time to travel</h2>
      </div>
      <div class="seasons__grid">
        <a class="season reveal" href="best-time-kenya.html"><span>Jul – Oct</span><h3>The Great Migration</h3><p>Wildebeest and zebra cross the Mara in their millions — Kenya's most dramatic months.</p><span class="feat__more">Read the guide →</span></a>
        <a class="season reveal" href="best-time-kenya.html"><span>Jan – Mar</span><h3>Warm &amp; dry</h3><p>Big-cat sightings, newborn wildlife and clear skies over the savanna and the coast.</p><span class="feat__more">Read the guide →</span></a>
        <a class="season reveal" href="best-time-kenya.html"><span>Dec – Mar</span><h3>Coast &amp; islands</h3><p>The Swahili coast and Lamu are at their sunny, balmy best for beach days and dhow sails.</p><span class="feat__more">Read the guide →</span></a>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="cta-band">
    <div class="container reveal">
      <h2>Ready to see Kenya?</h2>
      <p>Tell us how you like to travel and your designer will craft a Kenya journey around you — no pressure, no obligation.</p>
      <a href="contact.html" class="btn btn--gold">Plan your journey</a>
    </div>
  </section>

  <!-- Footer -->

</Base>

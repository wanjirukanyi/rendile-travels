---
import Base from '../layouts/BaseLayout.astro';
---
<Base
  title={`Custom Safaris | Tailor Made Journeys Across East Africa | Rendile Travels`}
  description={`We plan custom, tailor made safaris anywhere in East Africa, Kenya, Tanzania, Rwanda, Uganda, Zanzibar and beyond. Private journeys designed for women, around you.`}
  ogTitle={`Custom Safaris | Tailor Made Journeys Across East Africa | Rendile Travels`}
  ogDescription={`Private, tailor made safaris anywhere in East Africa, designed entirely around you.`}
  ogType={`website`}
  ogImage={`assets/img/hero-women.jpg`}
  canonical={`https://rendiletravels.com/custom-safaris.html`}
  keywords={`custom safari, tailor-made safari, private safari East Africa, bespoke safari Kenya Tanzania, women's custom safari`}
  announce
>

<!-- Page hero -->
  <section class="page-hero">
    <div class="page-hero__media" style="background-image:url('assets/img/hero-women.jpg')"></div>
    <div class="page-hero__scrim"></div>
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--light reveal">Tailor made</p>
      <h1 class="reveal">Custom Safaris</h1>
      <p class="page-hero__sub reveal">Your East Africa, designed entirely around you, anywhere you dream of going.</p>
      <div class="hero__actions reveal" style="margin-top:1.6rem">
        <a href="contact.html" class="btn btn--gold">Start planning</a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section">
    <div class="container">
      <div class="prose reveal">
        <p class="eyebrow">No two journeys alike</p>
        <h2 class="section__title">A trip planned around you, anywhere in East Africa.</h2>
        <p>Our signature trips are a starting point. If you'd rather travel just as <em>you</em> wish, your dates, your pace, your people, we'll craft a one of a kind private journey across Kenya, Tanzania, Rwanda, Uganda, Zanzibar and beyond. Tell us the trip you're dreaming of and we'll make it real.</p>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="section section--cream pillars">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Why travel custom with us</p>
        <h2 class="section__title">Yours, down to the last detail.</h2>
      </div>
      <div class="pillars__grid">
        <article class="pillar reveal">
          <span class="pillar__num">01</span>
          <h3>Designed around you</h3>
          <p>A personal travel designer composes your itinerary from scratch, the right camps, the right pace, no two journeys alike.</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__num">02</span>
          <h3>Women first &amp; safe</h3>
          <p>Vetted, women friendly stays, female guides where possible, women only options, and safety woven through every day.</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__num">03</span>
          <h3>With you the whole way</h3>
          <p>From the first idea to the journey home, your designer and a 24/7 concierge hold every detail so you can simply be present.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section way-process">
    <div class="container way-process__inner">
      <div class="way-process__media reveal" style="background-image:url('assets/img/kenya.jpg')"></div>
      <div class="way-process__text">
        <div class="section__head section__head--left reveal">
          <p class="eyebrow">How it works</p>
          <h2 class="section__title">Effortless from the first conversation.</h2>
        </div>
        <ol class="steps">
          <li class="step reveal">
            <span class="step__num">1</span>
            <div><h3>Tell us your dream</h3><p>A relaxed call with your travel designer, what you love, what worries you, and how you want to feel.</p></div>
          </li>
          <li class="step reveal">
            <span class="step__num">2</span>
            <div><h3>We design your journey</h3><p>A bespoke, illustrated itinerary with hand picked camps and the right rhythm, refined together until it's perfect.</p></div>
          </li>
          <li class="step reveal">
            <span class="step__num">3</span>
            <div><h3>You travel, we hold the details</h3><p>Private transfers, vetted guides and a concierge on call, day and night. You simply arrive and be present.</p></div>
          </li>
        </ol>
        <a href="contact.html" class="link-arrow link-arrow--dark reveal">Begin with a conversation →</a>
      </div>
    </div>
  </section>

  <!-- What you can tailor -->
  <section class="section section--cream ways">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Make it yours</p>
        <h2 class="section__title">What you can tailor</h2>
      </div>
      <div class="ways__grid">
        <article class="way reveal"><h3>Destinations &amp; route</h3><p>One country or a seamless multicountry journey across East Africa.</p></article>
        <article class="way reveal"><h3>Lodges &amp; camps</h3><p>From intimate tented camps to private villas and barefoot beach houses.</p></article>
        <article class="way reveal"><h3>Pace &amp; activities</h3><p>Slow and restful or full of adventure, game drives, treks, wellness, culture.</p></article>
        <article class="way reveal"><h3>Who travels</h3><p>Solo, women only, mothers &amp; daughters, friends, or a fully private group.</p></article>
        <article class="way reveal"><h3>Themes</h3><p>Safari, gorillas, the Great Migration, beach &amp; wellness, conservation, culture.</p></article>
        <article class="way reveal"><h3>Length &amp; budget</h3><p>A long weekend or a grand three week odyssey, shaped to your budget.</p></article>
      </div>
    </div>
  </section>

  <!-- Where we travel -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Where we travel</p>
        <h2 class="section__title">All of East Africa, and beyond.</h2>
        <p class="section__intro">We start here, and we grow where you want to go next.</p>
      </div>
      <div class="feat__grid">
        <article class="feat reveal"><div class="feat__img" style="background-image:url('assets/img/kenya.jpg')"></div><div class="feat__body"><h3>Kenya</h3><p>The Mara, Amboseli, the Rift &amp; the Swahili coast.</p></div></article>
        <article class="feat reveal"><div class="feat__img" style="background-image:url('assets/img/tanzania.jpg')"></div><div class="feat__body"><h3>Tanzania</h3><p>Serengeti, Ngorongoro &amp; the Great Migration.</p></div></article>
        <article class="feat reveal"><div class="feat__img" style="background-image:url('assets/img/rwanda.jpg')"></div><div class="feat__body"><h3>Rwanda</h3><p>Mountain gorillas &amp; the land of a thousand hills.</p></div></article>
        <article class="feat reveal"><div class="feat__img" style="background-image:url('assets/img/uganda.jpg')"></div><div class="feat__body"><h3>Uganda</h3><p>Primates, the Nile &amp; tree climbing lions.</p></div></article>
        <article class="feat reveal"><div class="feat__img" style="background-image:url('assets/img/trip-zanzibar.jpg')"></div><div class="feat__body"><h3>Zanzibar &amp; the coast</h3><p>Indian Ocean beaches, dhows &amp; spice island stillness.</p></div></article>
        <article class="feat reveal"><div class="feat__img" style="background-image:url('assets/img/kenya-migration.jpg')"></div><div class="feat__body"><h3>Beyond, on request</h3><p>Dreaming further afield? Tell us, we grow with you.</p></div></article>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="cta-band">
    <div class="container reveal">
      <h2>Let's design your custom safari.</h2>
      <p>Share a few details and your personal travel designer will be in touch within one business day, no pressure, no obligation.</p>
      <a href="contact.html" class="btn btn--gold">Start planning</a>
    </div>
  </section>

  <!-- Footer -->

</Base>

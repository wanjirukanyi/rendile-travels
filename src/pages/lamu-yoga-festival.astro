---
import Base from '../layouts/BaseLayout.astro';
---
<Base
  title={`Lamu Yoga Festival Trip | 5 Days on Kenya's Swahili Coast | Rendile Travels`}
  description={`Join Kenya's Lamu Yoga & Wellbeing Festival on a 5 day trip, beachfront yoga, dhow cruises, mangrove swims and Swahili feasts on the islands of Lamu and Manda. From $5,600.`}
  ogTitle={`Lamu Yoga Festival Trip | 5 Days on Kenya's Swahili Coast | Rendile Travels`}
  ogDescription={`Beachfront yoga, dhow cruises and Swahili feasts at the Lamu Yoga Festival, 5 days, from $5,600.`}
  ogType={`website`}
  ogImage={`assets/img/trip-lamu.jpg`}
  canonical={`https://rendiletravels.com/lamu-yoga-festival.html`}
  jsonld={`{"@context":"https://schema.org","@type":"TouristTrip","name":"Lamu Yoga Festival Trip — 5 Days","description":"A 5-day wellness trip to Kenya's Lamu Yoga & Wellbeing Festival on the Swahili coast.","image":"https://rendiletravels.com/assets/img/trip-lamu.jpg","provider":{"@type":"Organization","name":"Rendile Travels"},"offers":{"@type":"Offer","price":"5600","priceCurrency":"USD"}}`}
  credit={`Imagery via Wikimedia Commons &amp; Pexels: Lamu dhows © Bingar1234, licensed under <a href="https://creativecommons.org/licenses/by-sa/4.0" target="_blank" rel="license noopener">CC BY-SA 4.0</a>.`}
>

<section class="page-hero">
    <div class="page-hero__media" style="background-image:url('assets/img/lamu-hero.jpg')"></div>
    <div class="page-hero__scrim"></div>
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--light reveal">Kenya · Itinerary</p>
      <h1 class="reveal">Lamu Yoga Festival</h1>
      <div class="itin-meta reveal">
        <span><b>5 days</b></span>
        <span>Lamu &amp; Manda Islands</span>
        <span>Women &amp; men · adults only</span>
        <span>from <b>$5,600</b> / person</span>
      </div>
      <div class="hero__actions reveal" style="margin-top:1.6rem"><a href="contact.html" class="btn btn--gold">Enquire about this trip</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="article reveal">
        <nav class="breadcrumb"><a href="index.html">Home</a> / <a href="kenya.html">Kenya</a> / Lamu Yoga Festival</nav>
        <p class="article__lead">Kenya's beloved Lamu Yoga &amp; Wellbeing Festival, on the timeless Swahili coast. Five days of beachfront yoga and meditation across the islands of Lamu and Manda, woven with dhow cruises, mangrove swims, Swahili feasts and sunset bonfires.</p>
        <p>Over a hundred classes with teachers from around the world, set in a UNESCO listed old town. Open to women and men (adults only); we handle flights, a beautiful house or boutique stay, and every transfer between islands.</p>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">Day by day</p><h2 class="section__title">Your 5 day journey</h2></div>
      <div class="days">
        <div class="day reveal"><div class="day__num">Day 1</div><div class="day__body"><h3>Fly to Lamu</h3><p>Fly from Nairobi to the coast and transfer by boat to Shela. Settle into your house, then an evening welcome class and ceremony as the sun goes down.</p><p class="day__stay"><b>Stay:</b> Swahili house / boutique hotel · <b>Meals:</b> Dinner</p></div></div>
        <div class="day reveal"><div class="day__num">Day 2</div><div class="day__body"><h3>Festival days begin</h3><p>Early bird beach yoga, then your pick of workshops, movement, meditation, breath work and sound healing, with time to swim and rest.</p><p class="day__stay"><b>Stay:</b> Swahili house / boutique hotel · <b>Meals:</b> Breakfast</p></div></div>
        <div class="day reveal"><div class="day__num">Day 3</div><div class="day__body"><h3>Dhow &amp; dune</h3><p>More classes by day; in the evening a dune walk and meditation followed by a Swahili dinner under the stars.</p><p class="day__stay"><b>Stay:</b> Swahili house / boutique hotel · <b>Meals:</b> Breakfast</p></div></div>
        <div class="day reveal"><div class="day__num">Day 4</div><div class="day__body"><h3>Mangroves &amp; celebration</h3><p>A mangrove swim and sunset dhow cruise, then dance, satsang and a bonfire celebration on the beach.</p><p class="day__stay"><b>Stay:</b> Swahili house / boutique hotel · <b>Meals:</b> Breakfast</p></div></div>
        <div class="day reveal"><div class="day__num">Day 5</div><div class="day__body"><h3>Farewell to Lamu</h3><p>A final morning class and a wander through Lamu's old town and market before your flight home, or extend with a few days on a private beach.</p><p class="day__stay"><b>Meals:</b> Breakfast</p></div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="incl reveal">
        <div class="section__head section__head--left"><p class="eyebrow">All taken care of</p><h2 class="section__title">What's included</h2></div>
        <ul class="incl__grid">
          <li>Return flights Nairobi to Lamu &amp; boat transfers</li>
          <li>Festival pass &amp; classes</li>
          <li>Beautiful Swahili house or boutique stay</li>
          <li>Daily breakfast &amp; welcome dinner</li>
          <li>Dhow cruise &amp; island excursions</li>
          <li>Old town walking tour</li>
          <li>24/7 Rendile concierge</li>
          <li>All transfer gratuities</li>
        </ul>
        <p style="margin-top:1.2rem;color:var(--ink-soft)">From <strong>$5,600 per person sharing</strong>. The festival runs around October to November each year. International flights and visas are extra. Adults only.</p>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container reveal"><h2>Yoga, dhows and sisterhood await.</h2><p>Spaces at the festival are limited, reserve early and we'll handle the rest.</p><a href="contact.html" class="btn btn--gold">Enquire about this trip</a></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">More journeys</p><h2 class="section__title">Other Kenya itineraries</h2></div>
      <div class="related__grid reveal">
        <a class="feat" href="classic-kenya-safari.html"><div class="feat__img" style="background-image:url('assets/img/kenya-amboseli.jpg')"></div><div class="feat__body"><h3>Classic Kenya Safari</h3><p>8 days · Mara, Amboseli &amp; Nakuru.</p></div></a>
        <a class="feat" href="kenya.html#itineraries"><div class="feat__img" style="background-image:url('assets/img/kenya-cheetah.jpg')"></div><div class="feat__body"><h3>Savanna to Sea</h3><p>10 days · Safari &amp; beach.</p></div></a>
        <a class="feat" href="kenya.html"><div class="feat__img" style="background-image:url('assets/img/kenya.jpg')"></div><div class="feat__body"><h3>All Kenya itineraries</h3><p>Browse every Kenya journey.</p></div></a>
      </div>
    </div>
  </section>

</Base>

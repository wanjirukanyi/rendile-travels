---
import Base from '../layouts/BaseLayout.astro';
---
<Base
  title={`The Journal | East Africa Travel Guides & Stories | Rendile Travels`}
  description={`The Rendile Journal, destination guides, wildlife highlights and best time advice for Kenya, Tanzania, Uganda and Rwanda, written for women travelling in East Africa.`}
  ogTitle={`The Journal | East Africa Travel Guides & Stories | Rendile Travels`}
  ogDescription={`Destination guides, wildlife highlights and best time advice for Kenya, Tanzania, Uganda and Rwanda.`}
  ogType={`website`}
  ogImage={`assets/img/tanzania-hero.jpg`}
  canonical={`https://rendiletravels.com/journal.html`}
  keywords={`East Africa travel guide, safari blog, Kenya Tanzania Uganda Rwanda guides, women travel East Africa, best time to visit safari`}
  credit={`Imagery via Wikimedia Commons &amp; Pexels, licensed under CC BY / CC BY-SA / CC0. Full credits on each guide.`}
>

<section class="page-hero">
    <div class="page-hero__media" style="background-image:url('assets/img/tanzania-hero.jpg')"></div>
    <div class="page-hero__scrim"></div>
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--light reveal">The Journal</p>
      <h1 class="reveal">Guides &amp; Stories</h1>
      <p class="page-hero__sub reveal">Destination guides, wildlife highlights and when to go advice for East Africa.</p>
    </div>
  </section>

  <!-- Kenya -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">Kenya</p><h2 class="section__title">Kenya guides</h2></div>
      <div class="feat__grid">
        <a class="feat reveal" href="maasai-mara.html"><div class="feat__img" style="background-image:url('assets/img/kenya-migration.jpg')"></div><div class="feat__body"><h3>Maasai Mara</h3><p>The Great Migration &amp; big cats.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="amboseli.html"><div class="feat__img" style="background-image:url('assets/img/kenya-amboseli.jpg')"></div><div class="feat__body"><h3>Amboseli</h3><p>Elephants beneath Kilimanjaro.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="lake-nakuru.html"><div class="feat__img" style="background-image:url('assets/img/kenya-nakuru.jpg')"></div><div class="feat__body"><h3>Lake Nakuru</h3><p>Flamingos &amp; the Great Rift.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="samburu.html"><div class="feat__img" style="background-image:url('assets/img/kenya-samburu.jpg')"></div><div class="feat__body"><h3>Samburu</h3><p>The wild, arid north.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="lamu-coast.html"><div class="feat__img" style="background-image:url('assets/img/kenya-lamu.jpg')"></div><div class="feat__body"><h3>Lamu &amp; the Coast</h3><p>Swahili towns &amp; dhow sails.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="nairobi.html"><div class="feat__img" style="background-image:url('assets/img/kenya-nairobi.jpg')"></div><div class="feat__body"><h3>Nairobi</h3><p>Giraffe Manor &amp; the city.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="best-time-kenya.html"><div class="feat__img" style="background-image:url('assets/img/kenya-cheetah.jpg')"></div><div class="feat__body"><h3>Best time to visit Kenya</h3><p>Month by month guide.</p><span class="feat__more">Read more →</span></div></a>
      </div>
    </div>
  </section>

  <!-- Tanzania -->
  <section class="section section--cream">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">Tanzania</p><h2 class="section__title">Tanzania guides</h2></div>
      <div class="feat__grid">
        <a class="feat reveal" href="serengeti.html"><div class="feat__img" style="background-image:url('assets/img/tz-serengeti.jpg')"></div><div class="feat__body"><h3>Serengeti</h3><p>Endless plains &amp; the migration.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="ngorongoro-crater.html"><div class="feat__img" style="background-image:url('assets/img/tz-ngorongoro.jpg')"></div><div class="feat__body"><h3>Ngorongoro Crater</h3><p>The Big Five in one bowl.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="tarangire.html"><div class="feat__img" style="background-image:url('assets/img/tz-tarangire.jpg')"></div><div class="feat__body"><h3>Tarangire</h3><p>Elephants &amp; ancient baobabs.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="kilimanjaro.html"><div class="feat__img" style="background-image:url('assets/img/tz-kilimanjaro.jpg')"></div><div class="feat__body"><h3>Mount Kilimanjaro</h3><p>The roof of Africa.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="lake-manyara.html"><div class="feat__img" style="background-image:url('assets/img/tz-manyara.jpg')"></div><div class="feat__body"><h3>Lake Manyara</h3><p>Tree climbing lions &amp; flamingos.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="zanzibar.html"><div class="feat__img" style="background-image:url('assets/img/tz-zanzibar.jpg')"></div><div class="feat__body"><h3>Zanzibar</h3><p>Stone Town &amp; the beaches.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="best-time-tanzania.html"><div class="feat__img" style="background-image:url('assets/img/tanzania-hero.jpg')"></div><div class="feat__body"><h3>Best time to visit Tanzania</h3><p>Month by month guide.</p><span class="feat__more">Read more →</span></div></a>
      </div>
    </div>
  </section>

  <!-- Uganda -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">Uganda</p><h2 class="section__title">Uganda guides</h2></div>
      <div class="feat__grid">
        <a class="feat reveal" href="bwindi.html"><div class="feat__img" style="background-image:url('assets/img/ug-bwindi.jpg')"></div><div class="feat__body"><h3>Bwindi Impenetrable Forest</h3><p>Mountain gorilla trekking.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="queen-elizabeth.html"><div class="feat__img" style="background-image:url('assets/img/ug-qenp.jpg')"></div><div class="feat__body"><h3>Queen Elizabeth</h3><p>Tree climbing lions &amp; Kazinga.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="kibale-forest.html"><div class="feat__img" style="background-image:url('assets/img/ug-kibale.jpg')"></div><div class="feat__body"><h3>Kibale Forest</h3><p>The chimpanzee capital.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="murchison-falls.html"><div class="feat__img" style="background-image:url('assets/img/ug-murchison.jpg')"></div><div class="feat__body"><h3>Murchison Falls</h3><p>The Nile through a gorge.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="lake-bunyonyi.html"><div class="feat__img" style="background-image:url('assets/img/ug-bunyonyi.jpg')"></div><div class="feat__body"><h3>Lake Bunyonyi</h3><p>Terraced hills &amp; islands.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="jinja-nile.html"><div class="feat__img" style="background-image:url('assets/img/ug-nile.jpg')"></div><div class="feat__body"><h3>Jinja &amp; the Nile</h3><p>The source of the great river.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="best-time-uganda.html"><div class="feat__img" style="background-image:url('assets/img/uganda-hero.jpg')"></div><div class="feat__body"><h3>Best time to visit Uganda</h3><p>Season by season guide.</p><span class="feat__more">Read more →</span></div></a>
      </div>
    </div>
  </section>

  <!-- Rwanda -->
  <section class="section section--cream">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">Rwanda</p><h2 class="section__title">Rwanda guides</h2></div>
      <div class="feat__grid">
        <a class="feat reveal" href="volcanoes-national-park.html"><div class="feat__img" style="background-image:url('assets/img/rw-volcanoes.jpg')"></div><div class="feat__body"><h3>Volcanoes National Park</h3><p>Gorillas &amp; golden monkeys.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="nyungwe-forest.html"><div class="feat__img" style="background-image:url('assets/img/rw-nyungwe.jpg')"></div><div class="feat__body"><h3>Nyungwe Forest</h3><p>The canopy walk &amp; chimps.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="akagera.html"><div class="feat__img" style="background-image:url('assets/img/rw-akagera.jpg')"></div><div class="feat__body"><h3>Akagera</h3><p>Big Five savanna restored.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="lake-kivu.html"><div class="feat__img" style="background-image:url('assets/img/rw-kivu.jpg')"></div><div class="feat__body"><h3>Lake Kivu</h3><p>Beaches &amp; island calm.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="kigali.html"><div class="feat__img" style="background-image:url('assets/img/rw-kigali.jpg')"></div><div class="feat__body"><h3>Kigali</h3><p>A clean, creative capital.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="thousand-hills.html"><div class="feat__img" style="background-image:url('assets/img/rw-thousandhills.jpg')"></div><div class="feat__body"><h3>Land of a thousand hills</h3><p>Tea country &amp; scenery.</p><span class="feat__more">Read more →</span></div></a>
        <a class="feat reveal" href="best-time-rwanda.html"><div class="feat__img" style="background-image:url('assets/img/rwanda-hero.jpg')"></div><div class="feat__body"><h3>Best time to visit Rwanda</h3><p>Season by season guide.</p><span class="feat__more">Read more →</span></div></a>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container reveal">
      <h2>Inspired to travel?</h2>
      <p>Tell us which stories caught your eye and your designer will turn them into a journey.</p>
      <a href="contact.html" class="btn btn--gold">Start planning</a>
    </div>
  </section>

</Base>

  ogTitle={`Uganda Family Adventure — 6-Day Itinerary | Rendile Travels`}
  ogDescription={`Jinja, Lake Mburo and a chimp sanctuary — a gentle Uganda family adventure. 6 days from $4,600.`}
  ogType={`website`}

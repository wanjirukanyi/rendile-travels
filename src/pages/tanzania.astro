---
import Base from '../layouts/BaseLayout.astro';
---
<Base
  title={`Tanzania — Safaris & Itineraries | Rendile Travels`}
  description={`Tanzania itineraries for women — the Serengeti and the Great Migration, the Ngorongoro Crater, Kilimanjaro and the spice island of Zanzibar. Tailor-made luxury journeys, curated end to end by Rendile Travels.`}
  ogTitle={`Tanzania — Safaris & Itineraries | Rendile Travels`}
  ogType={`website`}
  ogImage={`assets/logo-orange.png`}
  credit={`Imagery via Wikimedia Commons: Maasai woman © Ondřej Havelka; Serengeti © Tanzania GET Safaris; Ngorongoro © Eric Kilby; Tarangire © Leyo; Kilimanjaro © Sergey Pesterev; Lake Manyara © John Mackenzie Burke; Zanzibar © The Erica Chang. Licensed under <a href="https://creativecommons.org/licenses/by/4.0" target="_blank" rel="license noopener">CC BY</a> / <a href="https://creativecommons.org/licenses/by-sa/4.0" target="_blank" rel="license noopener">CC BY-SA</a>.`}
  announce
>

<!-- Page hero -->
  <section class="page-hero">
    <div class="page-hero__media" style="background-image:url('assets/img/tanzania-hero.jpg')"></div>
    <div class="page-hero__scrim"></div>
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--light reveal">Destination</p>
      <h1 class="reveal">Tanzania</h1>
      <p class="page-hero__sub reveal">The Serengeti &amp; beyond.</p>
    </div>
  </section>

  <!-- Itineraries (lead) -->
  <section class="section journeys" id="itineraries">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Tanzania itineraries</p>
        <h2 class="section__title">Journeys through Tanzania</h2>
        <p class="section__intro">Starting points, not fixed menus — every itinerary is reshaped entirely around you, your pace and your people.</p>
      </div>

      <div class="journeys__grid">
        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/tz-ngorongoro.jpg')">
            <span class="journey__tag">Serengeti · Ngorongoro · Tarangire</span>
          </div>
          <div class="journey__body">
            <h3>Classic Northern Circuit</h3>
            <p class="journey__meta">8 days · Private &amp; tailor-made</p>
            <p>The icons of the north in one journey — endless Serengeti plains, the wildlife-packed Ngorongoro Crater, and Tarangire's elephants and ancient baobabs.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$8,200</strong> <em>/ person</em></span>
              <a href="classic-northern-circuit.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/tz-serengeti.jpg')">
            <span class="journey__tag">Serengeti · Jun–Oct</span>
          </div>
          <div class="journey__body">
            <h3>The Great Migration</h3>
            <p class="journey__meta">7 days · Private or small-group</p>
            <p>Front-row seats to the wildebeest's Mara River crossings — the world's greatest wildlife spectacle, from camps set right on the herds' path.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$7,400</strong> <em>/ person</em></span>
              <a href="tanzania-great-migration.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/tz-zanzibar.jpg')">
            <span class="journey__tag">Serengeti · Zanzibar</span>
          </div>
          <div class="journey__body">
            <h3>Serengeti &amp; Zanzibar</h3>
            <p class="journey__meta">10 days · Safari &amp; beach</p>
            <p>Big cats and golden plains, then barefoot days and dhow sails on the spice island's turquoise coast — the perfect full taste of Tanzania.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$9,800</strong> <em>/ person</em></span>
              <a href="serengeti-and-zanzibar.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/tz-kilimanjaro.jpg')">
            <span class="journey__tag">Kilimanjaro · Tarangire</span>
          </div>
          <div class="journey__body">
            <h3>Kilimanjaro &amp; the Wild North</h3>
            <p class="journey__meta">9 days · Trek &amp; safari</p>
            <p>Walk the gentle Machame route towards the roof of Africa, then unwind on safari beneath Kilimanjaro's snows — supported every step by our team.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$8,600</strong> <em>/ person</em></span>
              <a href="kilimanjaro-wild-north.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/tz-tarangire.jpg')">
            <span class="journey__tag">Tarangire · Ngorongoro · Family</span>
          </div>
          <div class="journey__body">
            <h3>Tanzania Family Safari</h3>
            <p class="journey__meta">6 days · Mothers &amp; children</p>
            <p>A gentle northern loop made for families — short drives, big wildlife and welcoming lodges with room for everyone to roam.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$5,200</strong> <em>/ person</em></span>
              <a href="tanzania-family-safari.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/tz-manyara.jpg')">
            <span class="journey__tag">Serengeti · Ngorongoro · Women-only</span>
          </div>
          <div class="journey__body">
            <h3>Women-Only Tanzania</h3>
            <p class="journey__meta">8 days · Small hosted group</p>
            <p>Our sisterhood departure through the Serengeti and Ngorongoro with a female host, vetted camps and a circle of like-minded women.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$8,900</strong> <em>/ person</em></span>
              <a href="women-only-tanzania.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>
      </div>

      <div class="journeys__cta reveal">
        <a href="contact.html" class="btn btn--gold">Design your own Tanzania journey</a>
      </div>
    </div>
  </section>

  <!-- Why Tanzania -->
  <section class="section section--cream">
    <div class="container">
      <div class="prose reveal">
        <p class="eyebrow">Why Tanzania</p>
        <h2 class="section__title">Where the wild runs widest.</h2>
        <p>Tanzania is safari at its grandest — the Serengeti's endless plains, the Ngorongoro Crater's natural amphitheatre of wildlife, and over a million wildebeest thundering across the Mara River. Beyond the savanna, snow-capped Kilimanjaro rises over the north and the spice island of Zanzibar waits on the warm Indian Ocean.</p>
        <p>For women travelling with us, Tanzania is wonderfully rewarding and easy: superb camps, genuine hospitality, female guides where possible, and a Rendile team on the ground every step of the way.</p>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Where to go</p>
        <h2 class="section__title">Tanzania's highlights</h2>
      </div>
      <div class="feat__grid">
        <a class="feat reveal" href="serengeti.html">
          <div class="feat__img" style="background-image:url('assets/img/tz-serengeti.jpg')"></div>
          <div class="feat__body"><h3>Serengeti</h3><p>Endless plains, big cats and the Great Migration's river crossings (Jun–Oct).</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="ngorongoro-crater.html">
          <div class="feat__img" style="background-image:url('assets/img/tz-ngorongoro.jpg')"></div>
          <div class="feat__body"><h3>Ngorongoro Crater</h3><p>A collapsed volcano sheltering thousands of animals — the Big Five in one bowl.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="tarangire.html">
          <div class="feat__img" style="background-image:url('assets/img/tz-tarangire.jpg')"></div>
          <div class="feat__body"><h3>Tarangire</h3><p>Great herds of elephants among ancient baobabs along the Tarangire River.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="kilimanjaro.html">
          <div class="feat__img" style="background-image:url('assets/img/tz-kilimanjaro.jpg')"></div>
          <div class="feat__body"><h3>Mount Kilimanjaro</h3><p>The snow-capped roof of Africa — trek it, or simply watch it glow at dawn.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="lake-manyara.html">
          <div class="feat__img" style="background-image:url('assets/img/tz-manyara.jpg')"></div>
          <div class="feat__body"><h3>Lake Manyara</h3><p>Flamingo-pink shallows, giraffes and Manyara's famous tree-climbing lions.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="zanzibar.html">
          <div class="feat__img" style="background-image:url('assets/img/tz-zanzibar.jpg')"></div>
          <div class="feat__body"><h3>Zanzibar</h3><p>Stone Town's spice-scented lanes, dhow sails and barefoot Indian Ocean beaches.</p><span class="feat__more">Read more →</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- Best time -->
  <section class="section section--cream">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">When to go</p>
        <h2 class="section__title">Best time to travel</h2>
      </div>
      <div class="seasons__grid">
        <a class="season reveal" href="best-time-tanzania.html"><span>Jun – Oct</span><h3>Migration &amp; dry season</h3><p>The herds reach the northern Serengeti and Mara River — peak game-viewing across the parks.</p><span class="feat__more">Read the guide →</span></a>
        <a class="season reveal" href="best-time-tanzania.html"><span>Jan – Mar</span><h3>Calving season</h3><p>The southern Serengeti fills with newborn wildebeest and the predators that follow them.</p><span class="feat__more">Read the guide →</span></a>
        <a class="season reveal" href="best-time-tanzania.html"><span>Jun – Oct</span><h3>Zanzibar &amp; the coast</h3><p>Warm, dry and clear — the spice island is at its sunny best for beach days and dhow sails.</p><span class="feat__more">Read the guide →</span></a>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="cta-band">
    <div class="container reveal">
      <h2>Ready to see Tanzania?</h2>
      <p>Tell us how you like to travel and your designer will craft a Tanzania journey around you — no pressure, no obligation.</p>
      <a href="contact.html" class="btn btn--gold">Plan your journey</a>
    </div>
  </section>

  <!-- Footer -->

</Base>

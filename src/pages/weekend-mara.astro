import Base from '../layouts/BaseLayout.astro';
---
<Base
  title={`A Weekend in the Mara — 3-Day Fly-In Safari Escape | Rendile Travels`}
  description={`A 3-day fly-in weekend safari to the Maasai Mara — perfect for those living in East Africa. Two nights on the plains, all game drives, at resident rates. Day-by-day itinerary and prices from $1,490.`}
  ogTitle={`A Weekend in the Mara — 3-Day Fly-In Safari Escape | Rendile Travels`}
  ogDescription={`A fly-in weekend on the Maasai Mara plains — 3 days from $1,490, resident rates available.`}
  ogType={`website`}
  ogImage={`assets/img/kenya-cheetah.jpg`}
  canonical={`https://rendiletravels.com/weekend-mara.html`}
  jsonld={`{"@context":"https://schema.org","@type":"TouristTrip","name":"A Weekend in the Mara — 3-Day Fly-In Safari Escape","description":"A 3-day fly-in weekend safari to the Maasai Mara, with resident rates available.","image":"https://rendiletravels.com/assets/img/kenya-cheetah.jpg","provider":{"@type":"Organization","name":"Rendile Travels"},"offers":{"@type":"Offer","price":"1490","priceCurrency":"USD"}}`}

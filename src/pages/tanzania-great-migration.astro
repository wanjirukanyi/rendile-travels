<Base
  title={`The Great Migration — 7-Day Serengeti Safari Itinerary | Rendile Travels`}
  description={`A 7-day Serengeti safari built around the Great Migration and the Mara River crossings (June–October) — front-row seats from camps right on the herds' path. Day-by-day itinerary and prices from $7,400.`}
  ogTitle={`The Great Migration — 7-Day Serengeti Safari Itinerary | Rendile Travels`}
  ogDescription={`Front-row seats to the Serengeti's Mara River crossings — a 7-day migration safari from $7,400.`}
  ogType={`website`}
  ogImage={`assets/img/tz-serengeti.jpg`}
  canonical={`https://rendiletravels.com/tanzania-great-migration.html`}
  jsonld={`{"@context":"https://schema.org","@type":"TouristTrip","name":"The Great Migration — 7-Day Serengeti Safari","description":"A 7-day Serengeti safari following the Great Migration and the Mara River crossings.","image":"https://rendiletravels.com/assets/img/tz-serengeti.jpg","provider":{"@type":"Organization","name":"Rendile Travels"},"offers":{"@type":"Offer","price":"7400","priceCurrency":"USD"}}`}

---
import Base from '../layouts/BaseLayout.astro';
---
<Base
  title={`Mummy and Me Safari | 5 Day Kenya Family Itinerary | Rendile Travels`}
  description={`A 5 day Mummy and Me family safari in Kenya, mothers and children bonding over wildlife, bush walks and starlit stories. Day by day itinerary and prices from $4,900.`}
  ogTitle={`Mummy and Me Safari | 5 Day Kenya Family Itinerary | Rendile Travels`}
  ogDescription={`A gentle 5 day family safari for mothers and children in Kenya, from $4,900.`}
  ogType={`website`}
  ogImage={`assets/img/trip-family.jpg`}
  canonical={`https://rendiletravels.com/mummy-and-me-safari.html`}
  jsonld={`{"@context":"https://schema.org","@type":"TouristTrip","name":"Mummy and Me Safari — 5-Day Kenya Family Itinerary","description":"A 5-day family safari in Kenya for mothers and children.","image":"https://rendiletravels.com/assets/img/trip-family.jpg","provider":{"@type":"Organization","name":"Rendile Travels"},"offers":{"@type":"Offer","price":"4900","priceCurrency":"USD"}}`}
  credit={`Imagery via Wikimedia Commons &amp; Pexels: Amboseli elephants &amp; Kilimanjaro © Ninaras, licensed under <a href="https://creativecommons.org/licenses/by/4.0" target="_blank" rel="license noopener">CC BY 4.0</a>.`}
>

<section class="page-hero">
    <div class="page-hero__media" style="background-image:url('assets/img/mummy-hero.jpg')"></div>
    <div class="page-hero__scrim"></div>
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--light reveal">Kenya · Itinerary</p>
      <h1 class="reveal">Mummy and Me Safari</h1>
      <div class="itin-meta reveal">
        <span><b>5 days</b></span>
        <span>Mara · Nairobi</span>
        <span>Mothers &amp; children</span>
        <span>from <b>$4,900</b> / person</span>
      </div>
      <div class="hero__actions reveal" style="margin-top:1.6rem"><a href="contact.html" class="btn btn--gold">Enquire about this trip</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="article reveal">
        <nav class="breadcrumb"><a href="index.html">Home</a> / <a href="kenya.html">Kenya</a> / Mummy and Me Safari</nav>
        <p class="article__lead">A gentle, joyful first safari designed for mothers and children to share, wildlife encounters by day, hot chocolate and starlit stories by night. Easy distances, family friendly camps, and guides who are wonderful with little ones.</p>
        <p>Five unhurried days that turn into a lifetime memory. Grandmothers, aunties and multigenerational groups are all warmly welcome.</p>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">Day by day</p><h2 class="section__title">Your 5 day journey</h2></div>
      <div class="days">
        <div class="day reveal"><div class="day__num">Day 1</div><div class="day__body"><h3>Welcome to Nairobi</h3><p>Met on arrival and taken to a family friendly hotel. An afternoon visit to the Sheldrick elephant orphanage or Giraffe Centre, an instant hit with children.</p><p class="day__stay"><b>Stay:</b> Nairobi hotel · <b>Meals:</b> Dinner</p></div></div>
        <div class="day reveal"><div class="day__num">Day 2</div><div class="day__body"><h3>Fly to the Maasai Mara</h3><p>A short, exciting flight, then into camp. A relaxed first game drive, giraffe, zebra and elephant make easy, delightful introductions.</p><p class="day__stay"><b>Stay:</b> Family tented camp · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Day 3</div><div class="day__body"><h3>Mara adventures</h3><p>A morning drive at the children's pace, then back to camp for a swim and a rest. Optional young ranger activities, spoor tracking and a Maasai visit.</p><p class="day__stay"><b>Stay:</b> Family tented camp · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Day 4</div><div class="day__body"><h3>Big cat morning &amp; bush stories</h3><p>An early drive in search of lions, then afternoon games, a bush picnic and stargazing with the guides after dinner.</p><p class="day__stay"><b>Stay:</b> Family tented camp · <b>Meals:</b> All</p></div></div>
        <div class="day reveal"><div class="day__num">Day 5</div><div class="day__body"><h3>Return to Nairobi &amp; farewell</h3><p>A final morning in the Mara, then fly back to Nairobi for your onward flight, full hearts and full memory cards.</p><p class="day__stay"><b>Meals:</b> Breakfast</p></div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="incl reveal">
        <div class="section__head section__head--left"><p class="eyebrow">All taken care of</p><h2 class="section__title">What's included</h2></div>
        <ul class="incl__grid">
          <li>All internal flights &amp; private transfers</li>
          <li>Family friendly camps &amp; hotels</li>
          <li>All meals as shown</li>
          <li>Private guide &amp; game drives</li>
          <li>All park fees</li>
          <li>Child friendly activities</li>
          <li>24/7 Rendile concierge</li>
          <li>All gratuities to guides &amp; staff</li>
        </ul>
        <p style="margin-top:1.2rem;color:var(--ink-soft)">From <strong>$4,900 per person sharing</strong>; child rates available. International flights and visas are extra. Suitable year round.</p>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container reveal"><h2>A safari you'll share forever.</h2><p>Tell us your children's ages and we'll shape the perfect family pace.</p><a href="contact.html" class="btn btn--gold">Enquire about this trip</a></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head reveal"><p class="eyebrow">More journeys</p><h2 class="section__title">Other Kenya itineraries</h2></div>
      <div class="related__grid reveal">
        <a class="feat" href="classic-kenya-safari.html"><div class="feat__img" style="background-image:url('assets/img/kenya-amboseli.jpg')"></div><div class="feat__body"><h3>Classic Kenya Safari</h3><p>8 days · Mara, Amboseli &amp; Nakuru.</p></div></a>
        <a class="feat" href="great-migration.html"><div class="feat__img" style="background-image:url('assets/img/kenya-migration.jpg')"></div><div class="feat__body"><h3>The Great Migration</h3><p>6 days · Maasai Mara (Jul to Oct).</p></div></a>
        <a class="feat" href="kenya.html"><div class="feat__img" style="background-image:url('assets/img/kenya.jpg')"></div><div class="feat__body"><h3>All Kenya itineraries</h3><p>Browse every Kenya journey.</p></div></a>
      </div>
    </div>
  </section>

</Base>

---
import Base from '../layouts/BaseLayout.astro';
---
<Base
  title={`Uganda — Gorillas, Chimps & Safaris | Rendile Travels`}
  description={`Uganda itineraries for women — mountain gorillas in Bwindi, chimpanzees in Kibale, tree-climbing lions in Queen Elizabeth, Murchison Falls and the source of the Nile. Tailor-made luxury journeys by Rendile Travels.`}
  ogTitle={`Uganda — Gorillas, Chimps & Safaris | Rendile Travels`}
  ogType={`website`}
  ogImage={`assets/logo-orange.png`}
  credit={`Imagery via Wikimedia Commons: tree-climbing lion © Fanny Schertzer; mountain gorilla © Charles J. Sharp; elephant family &amp; chimpanzee © Giles Laurent; Murchison Falls © NANTUMBWEJ; Lake Bunyonyi © Sjoerdug; Nile rapids © Ssemmanda Will; tea hills © Jameswasswa. Licensed under <a href="https://creativecommons.org/licenses/by/4.0" target="_blank" rel="license noopener">CC BY</a> / <a href="https://creativecommons.org/licenses/by-sa/4.0" target="_blank" rel="license noopener">CC BY-SA</a>.`}
  announce
>

<!-- Page hero -->
  <section class="page-hero">
    <div class="page-hero__media" style="background-image:url('assets/img/uganda-hero.jpg')"></div>
    <div class="page-hero__scrim"></div>
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--light reveal">Destination</p>
      <h1 class="reveal">Uganda</h1>
      <p class="page-hero__sub reveal">The pearl of Africa.</p>
    </div>
  </section>

  <!-- Itineraries (lead) -->
  <section class="section journeys" id="itineraries">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Uganda itineraries</p>
        <h2 class="section__title">Journeys through Uganda</h2>
        <p class="section__intro">Starting points, not fixed menus — every itinerary is reshaped entirely around you, your pace and your people.</p>
      </div>

      <div class="journeys__grid">
        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/ug-bwindi.jpg')">
            <span class="journey__tag">Bwindi · Kibale</span>
          </div>
          <div class="journey__body">
            <h3>Gorillas &amp; Chimpanzees</h3>
            <p class="journey__meta">7 days · Private &amp; tailor-made</p>
            <p>The two great-ape encounters in one journey — tracking mountain gorillas in Bwindi and chimpanzees in the Kibale forest.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$6,400</strong> <em>/ person</em></span>
              <a href="gorillas-and-chimpanzees.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/ug-qenp.jpg')">
            <span class="journey__tag">Murchison · Queen Elizabeth · Bwindi</span>
          </div>
          <div class="journey__body">
            <h3>Classic Uganda Safari</h3>
            <p class="journey__meta">10 days · Private or small-group</p>
            <p>The grand loop — Murchison Falls, the Kazinga Channel and tree-climbing lions of Queen Elizabeth, ending with the gorillas of Bwindi.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$7,900</strong> <em>/ person</em></span>
              <a href="classic-uganda-safari.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/ug-bunyonyi.jpg')">
            <span class="journey__tag">Bwindi · Lake Bunyonyi</span>
          </div>
          <div class="journey__body">
            <h3>Gorilla Trekking Short Break</h3>
            <p class="journey__meta">4 days · Private</p>
            <p>A focused first encounter — fly south-west for a day with a gorilla family in Bwindi, then unwind beside the terraced hills of Lake Bunyonyi.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$3,900</strong> <em>/ person</em></span>
              <a href="gorilla-trekking-short-break.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/ug-kibale.jpg')">
            <span class="journey__tag">Queen Elizabeth · Kibale · Bwindi</span>
          </div>
          <div class="journey__body">
            <h3>Primates &amp; Big Game</h3>
            <p class="journey__meta">8 days · Private &amp; tailor-made</p>
            <p>Chimpanzees in Kibale, lions and elephants in Queen Elizabeth, and the unforgettable gorillas of Bwindi — Uganda's wild heart in full.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$6,900</strong> <em>/ person</em></span>
              <a href="primates-and-big-game.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/ug-nile.jpg')">
            <span class="journey__tag">Jinja · Lake Mburo · Family</span>
          </div>
          <div class="journey__body">
            <h3>Uganda Family Adventure</h3>
            <p class="journey__meta">6 days · Mothers &amp; children</p>
            <p>A gentler mix of wildlife and water — boat safaris at Lake Mburo and the thrill of the Nile at Jinja, paced for families.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$4,600</strong> <em>/ person</em></span>
              <a href="uganda-family-adventure.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/ug-murchison.jpg')">
            <span class="journey__tag">Bwindi · Queen Elizabeth · Women-only</span>
          </div>
          <div class="journey__body">
            <h3>Women-Only Uganda Gorilla Journey</h3>
            <p class="journey__meta">8 days · Small hosted group</p>
            <p>Our sisterhood departure to the gorillas of Bwindi and the savannas of Queen Elizabeth, with a female host and a circle of like-minded women.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$7,200</strong> <em>/ person</em></span>
              <a href="women-only-uganda.html" class="link-arrow">View itinerary →</a>
            </div>
          </div>
        </article>
      </div>

      <div class="journeys__cta reveal">
        <a href="contact.html" class="btn btn--gold">Design your own Uganda journey</a>
      </div>
    </div>
  </section>

  <!-- Why Uganda -->
  <section class="section section--cream">
    <div class="container">
      <div class="prose reveal">
        <p class="eyebrow">Why Uganda</p>
        <h2 class="section__title">The pearl of Africa.</h2>
        <p>Winston Churchill called Uganda "the pearl of Africa" — and a century on, it still dazzles. Almost half the world's mountain gorillas live in the misty Bwindi forest, chimpanzees call through Kibale's canopy, and tree-climbing lions doze in the fig trees of Queen Elizabeth. The Nile begins its long journey north at Jinja, and the south-west folds into emerald terraced hills.</p>
        <p>For women travelling with us, Uganda is intimate and deeply rewarding: small lodges, warm hospitality, expert trackers, female guides where possible, and a Rendile team alongside you every step of the way.</p>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Where to go</p>
        <h2 class="section__title">Uganda's highlights</h2>
      </div>
      <div class="feat__grid">
        <a class="feat reveal" href="bwindi.html">
          <div class="feat__img" style="background-image:url('assets/img/ug-bwindi.jpg')"></div>
          <div class="feat__body"><h3>Bwindi Impenetrable Forest</h3><p>Almost half the world's mountain gorillas, tracked on foot through ancient rainforest.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="queen-elizabeth.html">
          <div class="feat__img" style="background-image:url('assets/img/ug-qenp.jpg')"></div>
          <div class="feat__body"><h3>Queen Elizabeth</h3><p>Tree-climbing lions, elephant herds and the wildlife-lined Kazinga Channel.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="kibale-forest.html">
          <div class="feat__img" style="background-image:url('assets/img/ug-kibale.jpg')"></div>
          <div class="feat__body"><h3>Kibale Forest</h3><p>The chimpanzee capital of East Africa, alive with thirteen primate species.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="murchison-falls.html">
          <div class="feat__img" style="background-image:url('assets/img/ug-murchison.jpg')"></div>
          <div class="feat__body"><h3>Murchison Falls</h3><p>The Nile forced through a seven-metre gorge, then a wildlife-rich delta.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="lake-bunyonyi.html">
          <div class="feat__img" style="background-image:url('assets/img/ug-bunyonyi.jpg')"></div>
          <div class="feat__body"><h3>Lake Bunyonyi</h3><p>Terraced hills around the "place of little birds" — among Africa's deepest lakes.</p><span class="feat__more">Read more →</span></div>
        </a>
        <a class="feat reveal" href="jinja-nile.html">
          <div class="feat__img" style="background-image:url('assets/img/ug-nile.jpg')"></div>
          <div class="feat__body"><h3>Jinja &amp; the Nile</h3><p>The source of the world's longest river, and East Africa's adventure capital.</p><span class="feat__more">Read more →</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- Best time -->
  <section class="section section--cream">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">When to go</p>
        <h2 class="section__title">Best time to travel</h2>
      </div>
      <div class="seasons__grid">
        <a class="season reveal" href="best-time-uganda.html"><span>Jun – Sep · Dec – Feb</span><h3>Dry-season trekking</h3><p>Bwindi and Kibale's forest trails are firmest and gorilla tracking is at its easiest.</p><span class="feat__more">Read the guide →</span></a>
        <a class="season reveal" href="best-time-uganda.html"><span>Jun – Aug</span><h3>Peak game viewing</h3><p>Thinner bush and water-drawn wildlife in Queen Elizabeth and Murchison Falls.</p><span class="feat__more">Read the guide →</span></a>
        <a class="season reveal" href="best-time-uganda.html"><span>Year-round</span><h3>Gorillas await</h3><p>Permits run all year; the greener wet months are quieter, with fewer trekkers on the trail.</p><span class="feat__more">Read the guide →</span></a>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="cta-band">
    <div class="container reveal">
      <h2>Ready to see Uganda?</h2>
      <p>Tell us how you like to travel and your designer will craft a Uganda journey around you — no pressure, no obligation.</p>
      <a href="contact.html" class="btn btn--gold">Plan your journey</a>
    </div>
  </section>

  <!-- Footer -->

</Base>

---
import Base from '../layouts/BaseLayout.astro';
---
<Base
  title={`Rendile Travels — Luxury Women's Retreats in Africa, Asia, Europe & the Middle East`}
  description={`Luxury retreats for women: one themed retreat a month in an intimate group, across Africa, Asia, Europe and the Middle East & North Africa. Or host your own.`}
  ogTitle={`Rendile Travels — Where Every Path Tells a Story`}
  ogDescription={`One themed retreat a month, in intimate small groups. Africa, Asia, Europe and the Middle East & North Africa, designed by women, for women.`}
  ogType={`website`}
  ogImage={`https://rendiletravels.com/assets/img/hero-cover.jpg`}
  credit={`Retreat photography and film via Pexels.`}
  announce
>

<!-- Hero -->
  <section class="hero">
    <div class="hero__media" role="img" aria-label="Women on a wellness retreat: beach yoga, safari, spa and sunsets" style="background-image:url('assets/img/hero-cover.jpg');background-position:center 60%">
      <video class="hero__vid" id="heroVidA" muted playsinline preload="auto" aria-hidden="true"></video>
      <video class="hero__vid" id="heroVidB" muted playsinline preload="none" aria-hidden="true"></video>
    </div>
    <div class="hero__scrim"></div>
    <div class="container hero__content">
      <p class="eyebrow eyebrow--light reveal">Luxury retreats for women · Africa, Asia, Europe &amp; beyond</p>
      <h1 class="hero__title reveal">Where Every Path<br/>Tells a Story</h1>
      <p class="hero__lead reveal">One themed retreat every month. A year of journeys designed by women, for women.</p>
      <div class="hero__actions reveal">
        <a href="#calendar" class="btn btn--gold">See the 2027 calendar</a>
        <a href="#retreats" class="btn btn--ghost">Explore retreats</a>
        <a href="#host" class="btn btn--ghost">Host your own</a>
      </div>
      <ul class="hero__trust reveal">
        <li>Intimate, women-only groups</li>
        <li>Designed by women, for women</li>
        <li>A new theme every month</li>
        <li>On-trip concierge</li>
      </ul>
    </div>
    <a href="#retreats" class="hero__scroll" aria-label="Scroll to explore">
      <span class="hero__scroll-text">Scroll to explore</span>
      <span class="hero__scroll-dot"></span>
    </a>
  </section>

  <!-- Retreat collections (5 pillars) -->
  <section class="section section--cream destinations" id="retreats">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Signature retreats</p>
        <h2 class="section__title">Retreats for women, around the world</h2>
        <p class="section__intro">One themed retreat every month, each in an intimate women-only group. Start in Africa, then travel on to Asia, Europe, and the Middle East &amp; North Africa, or host a retreat of your own.</p>
      </div>

      <div class="dest__grid regions__grid">
        <a class="dest reveal" href="#calendar" data-region="africa" style="background-image:url('assets/img/region-africa.jpg');background-size:cover;background-position:center">
          <div class="dest__body">
            <h3>Africa Retreats</h3>
            <p>Safari, coast &amp; islands</p>
          </div>
        </a>
        <a class="dest reveal" href="#calendar" data-region="asia" style="background-image:url('assets/img/region-asia.jpg');background-size:cover;background-position:center">
          <div class="dest__body">
            <h3>Asia Retreats</h3>
            <p>Bali, Thailand &amp; beyond</p>
          </div>
        </a>
        <a class="dest reveal" href="#calendar" data-region="europe" style="background-image:url('assets/img/region-europe.jpg');background-size:cover;background-position:center">
          <div class="dest__body">
            <h3>Europe Retreats</h3>
            <p>Italy, Greece &amp; the Med</p>
          </div>
        </a>
        <a class="dest reveal" href="#calendar" data-region="mena" style="background-image:url('assets/img/region-mena.jpg');background-size:cover;background-position:center">
          <div class="dest__body">
            <h3>Middle East &amp; North Africa</h3>
            <p>Morocco, Dubai &amp; Oman</p>
          </div>
        </a>
        <a class="dest reveal" href="#host" style="background-image:url('assets/img/hero-women.jpg');background-size:cover;background-position:center">
          <div class="dest__body">
            <h3>Host Your Own Retreat</h3>
            <p>Your group, your theme</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 2027 Retreat Calendar -->
  <section class="section section--cream journeys" id="calendar">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">2027 retreat calendar</p>
        <h2 class="section__title">One retreat a month. A year of journeys.</h2>
        <p class="section__intro">Every retreat has its own theme and a small, intimate group, so places are limited. Prices are per person and include your stays, meals, activities and on-trip host; flights are not included.</p>
      </div>

      <div class="cal-filters reveal" role="group" aria-label="Filter retreats by region">
        <button type="button" class="cal-filter is-active" data-filter="all">All</button>
        <button type="button" class="cal-filter" data-filter="africa">Africa</button>
        <button type="button" class="cal-filter" data-filter="asia">Asia</button>
        <button type="button" class="cal-filter" data-filter="europe">Europe</button>
        <button type="button" class="cal-filter" data-filter="mena">Middle East &amp; North Africa</button>
      </div>

      <div class="journeys__grid" id="calendarGrid">
        <article class="journey retreat reveal" data-region="africa">
          <div class="journey__media" style="background-image:url('assets/img/retreat-yoga.jpg')">
            <span class="retreat__month">Jan<em>2027</em></span>
            <span class="journey__tag">Nanyuki, Kenya</span>
          </div>
          <div class="journey__body">
            <h3>New Year, New You</h3>
            <p class="journey__meta">January · 6 days · Vision &amp; wellness</p>
            <p>Start the year with intention. Guided goal-setting and vision-board workshops, a personal plan for the year ahead, sunrise yoga, breathwork and spa time under Mount Kenya.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$3,900</strong> <em>/ person</em></span>
              <a href="new-year-new-you.html" class="link-arrow">Learn more →</a>
            </div>
          </div>
        </article>
        <article class="journey retreat reveal" data-region="africa">
          <div class="journey__media" style="background-image:url('assets/img/trip-zanzibar.jpg')">
            <span class="retreat__month">Feb<em>2027</em></span>
            <span class="journey__tag">Zanzibar</span>
          </div>
          <div class="journey__body">
            <h3>The Self-Love Retreat</h3>
            <p class="journey__meta">February · 7 days · Rest &amp; self-care</p>
            <p>A Galentine's month escape on Zanzibar's white-sand coast. Slow mornings, journaling circles, spa rituals, spice-farm walks and sunset dhow cruises.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$4,200</strong> <em>/ person</em></span>
              <a href="self-love-retreat.html" class="link-arrow">Learn more →</a>
            </div>
          </div>
        </article>
        <article class="journey retreat reveal" data-region="africa">
          <div class="journey__media" style="background-image:url('assets/img/cal-mar.jpg')">
            <span class="retreat__month">Mar<em>2027</em></span>
            <span class="journey__tag">Maasai Mara, Kenya</span>
          </div>
          <div class="journey__body">
            <h3>Women's Month Safari</h3>
            <p class="journey__meta">March · 6 days · Safari &amp; sisterhood</p>
            <p>Celebrate International Women's Day in the wild. Game drives with women guides, time with Maasai women's collectives and a bush dinner under the stars.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$5,400</strong> <em>/ person</em></span>
              <a href="contact.html?trip=Women%27s%20Month%20Safari%20%28March%202027%29" class="link-arrow">Reserve →</a>
            </div>
          </div>
        </article>
        <article class="journey retreat reveal" data-region="asia">
          <div class="journey__media" style="background-image:url('assets/img/cal-apr.jpg')">
            <span class="retreat__month">Apr<em>2027</em></span>
            <span class="journey__tag">Ubud &amp; Uluwatu, Bali</span>
          </div>
          <div class="journey__body">
            <h3>The Spiritual Reset</h3>
            <p class="journey__meta">April · 8 days · Yoga &amp; renewal</p>
            <p>Rice-terrace walks, temple blessings, daily yoga and a traditional Balinese healer, then barefoot days on the Uluwatu cliffs.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$4,600</strong> <em>/ person</em></span>
              <a href="contact.html?trip=The%20Spiritual%20Reset%20%28April%202027%29" class="link-arrow">Reserve →</a>
            </div>
          </div>
        </article>
        <article class="journey retreat reveal" data-region="europe">
          <div class="journey__media" style="background-image:url('assets/img/cal-may.jpg')">
            <span class="retreat__month">May<em>2027</em></span>
            <span class="journey__tag">Amalfi Coast, Italy</span>
          </div>
          <div class="journey__body">
            <h3>La Dolce Vita</h3>
            <p class="journey__meta">May · 7 days · Food, wine &amp; slow living</p>
            <p>Lemon groves, cooking with a local nonna, wine tastings and private boat days along the most beautiful coastline in Europe.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$6,800</strong> <em>/ person</em></span>
              <a href="contact.html?trip=La%20Dolce%20Vita%20%28May%202027%29" class="link-arrow">Reserve →</a>
            </div>
          </div>
        </article>
        <article class="journey retreat reveal" data-region="mena">
          <div class="journey__media" style="background-image:url('assets/img/cal-jun.jpg')">
            <span class="retreat__month">Jun<em>2027</em></span>
            <span class="journey__tag">Marrakech &amp; Sahara, Morocco</span>
          </div>
          <div class="journey__body">
            <h3>Desert &amp; Hammam</h3>
            <p class="journey__meta">June · 7 days · Beauty rituals &amp; adventure</p>
            <p>Riad living in the Medina, hammam and argan rituals, souk treasure-hunting, then a night in a luxury camp in the Sahara dunes.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$4,900</strong> <em>/ person</em></span>
              <a href="contact.html?trip=Desert%20%26%20Hammam%20%28June%202027%29" class="link-arrow">Reserve →</a>
            </div>
          </div>
        </article>
        <article class="journey retreat reveal" data-region="africa">
          <div class="journey__media" style="background-image:url('assets/img/cal-jul.jpg')">
            <span class="retreat__month">Jul<em>2027</em></span>
            <span class="journey__tag">Maasai Mara, Kenya</span>
          </div>
          <div class="journey__body">
            <h3>The Great Migration</h3>
            <p class="journey__meta">July · 6 days · Wildlife &amp; wonder</p>
            <p>The greatest show on earth, at its peak. River crossings, a dawn hot-air balloon and evenings around the fire with women who get it.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$6,200</strong> <em>/ person</em></span>
              <a href="contact.html?trip=The%20Great%20Migration%20%28July%202027%29" class="link-arrow">Reserve →</a>
            </div>
          </div>
        </article>
        <article class="journey retreat reveal" data-region="europe">
          <div class="journey__media" style="background-image:url('assets/img/cal-aug.jpg')">
            <span class="retreat__month">Aug<em>2027</em></span>
            <span class="journey__tag">Santorini &amp; Naxos, Greece</span>
          </div>
          <div class="journey__body">
            <h3>Sun &amp; Soul</h3>
            <p class="journey__meta">August · 7 days · Island living</p>
            <p>Whitewashed villages, caldera sunsets, sailing between islands and long Greek lunches by the sea.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$6,500</strong> <em>/ person</em></span>
              <a href="contact.html?trip=Sun%20%26%20Soul%20%28August%202027%29" class="link-arrow">Reserve →</a>
            </div>
          </div>
        </article>
        <article class="journey retreat reveal" data-region="africa">
          <div class="journey__media" style="background-image:url('assets/img/cal-sep.jpg')">
            <span class="retreat__month">Sep<em>2027</em></span>
            <span class="journey__tag">Volcanoes &amp; Kigali, Rwanda</span>
          </div>
          <div class="journey__body">
            <h3>Wild Wellness</h3>
            <p class="journey__meta">September · 6 days · Gorillas &amp; mindfulness</p>
            <p>An hour with the mountain gorillas, forest bathing, spa time at a volcano-view lodge and Kigali's women-led art and design scene.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$6,900</strong> <em>/ person</em></span>
              <a href="contact.html?trip=Wild%20Wellness%20%28September%202027%29" class="link-arrow">Reserve →</a>
            </div>
          </div>
        </article>
        <article class="journey retreat reveal" data-region="asia">
          <div class="journey__media" style="background-image:url('assets/img/cal-oct.jpg')">
            <span class="retreat__month">Oct<em>2027</em></span>
            <span class="journey__tag">Krabi, Thailand</span>
          </div>
          <div class="journey__body">
            <h3>Mindful Asia</h3>
            <p class="journey__meta">October · 8 days · Wellness &amp; beaches</p>
            <p>Thai massage, meditation with a local teacher, island-hopping by longtail boat and slow days on the Andaman Sea.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$4,400</strong> <em>/ person</em></span>
              <a href="contact.html?trip=Mindful%20Asia%20%28October%202027%29" class="link-arrow">Reserve →</a>
            </div>
          </div>
        </article>
        <article class="journey retreat reveal" data-region="africa">
          <div class="journey__media" style="background-image:url('assets/img/trip-lamu.jpg')">
            <span class="retreat__month">Nov<em>2027</em></span>
            <span class="journey__tag">Lamu, Kenya</span>
          </div>
          <div class="journey__body">
            <h3>Lamu Yoga Festival</h3>
            <p class="journey__meta">November · 5 days · Yoga on the Swahili coast</p>
            <p>Join Kenya's beloved Lamu Yoga &amp; Wellbeing Festival: beachfront yoga, workshops, dhow sails and Swahili feasts on Lamu and Manda.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$5,600</strong> <em>/ person</em></span>
              <a href="lamu-yoga-festival.html" class="link-arrow">Learn more →</a>
            </div>
          </div>
        </article>
        <article class="journey retreat reveal" data-region="mena">
          <div class="journey__media" style="background-image:url('assets/img/cal-dec.jpg')">
            <span class="retreat__month">Dec<em>2027</em></span>
            <span class="journey__tag">Dubai, UAE</span>
          </div>
          <div class="journey__body">
            <h3>Glow &amp; Celebrate</h3>
            <p class="journey__meta">December · 5 days · Year-end celebration</p>
            <p>Close the year in style. Desert sunset dinner, spa day, rooftop evenings and a farewell gala to celebrate everything you did this year.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$5,800</strong> <em>/ person</em></span>
              <a href="contact.html?trip=Glow%20%26%20Celebrate%20%28December%202027%29" class="link-arrow">Reserve →</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Host your own retreat -->
  <section class="section host" id="host">
    <div class="container host__inner">
      <div class="host__media reveal" style="background-image:url('assets/img/hero-women.jpg')"></div>
      <div class="host__body reveal">
        <p class="eyebrow">Host your own retreat</p>
        <h2 class="section__title">Your circle. Your theme. We handle everything.</h2>
        <p>Bring your own group of women, for a milestone birthday, a bridal trip, a book club, a wellness community or a women's leadership team. Choose any of our destinations and a theme, and we design a private retreat around you.</p>
        <ul class="host__list">
          <li>Private groups of any size, from a few close friends upwards</li>
          <li>Any destination: Africa, Asia, Europe, the Middle East &amp; North Africa</li>
          <li>Yoga teachers, coaches, chefs and photographers arranged for you</li>
          <li>One planner from first call to final farewell</li>
        </ul>
        <a href="contact.html?trip=Host%20Your%20Own%20Retreat" class="btn btn--gold">Plan your retreat</a>
      </div>
    </div>
  </section>

  <!-- The Rendile Difference -->
  <section class="section pillars" id="difference">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Why travel with us</p>
        <h2 class="section__title">The Rendile Difference</h2>
        <p class="section__intro">Journeys designed by women, for women. Every detail considered, every path a story worth telling.</p>
      </div>

      <div class="pillars__grid">
        <article class="pillar reveal">
          <span class="pillar__num">01</span>
          <h3>Curated Itineraries</h3>
          <p>No cookie-cutter trips. Each experience is uniquely crafted around you — your pace, your passions, your comfort.</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__num">02</span>
          <h3>Authentic Connections</h3>
          <p>Meet local women, artisans, and change-makers along the way. Travel that opens doors, not just itineraries.</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__num">03</span>
          <h3>Intimate by Design</h3>
          <p>Small, intimate groups, or fully private when you host your own. Real connections, not crowds, and safety woven through every day.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Stories from the Road -->
  <section class="section reviews" id="reviews">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Stories from the road</p>
        <h2 class="section__title">Loved by the women who travel with us.</h2>
        <div class="stars" aria-label="5 out of 5 stars">★★★★★ <span>5.0 · from every traveller, so far</span></div>
      </div>

      <div class="reviews__track" id="reviewsTrack">
        <figure class="review is-active">
          <blockquote>"I travelled solo for the first time at 54 and never once felt alone or unsafe. Every stay, every guide, every sunrise was thought through. I came home a different woman."</blockquote>
          <figcaption><strong>Wanjiru K.</strong><span>Nairobi → Maasai Mara &amp; Serengeti</span></figcaption>
        </figure>
        <figure class="review">
          <blockquote>"The women-only departure was the trip of my life. Strangers on day one, friends for life by day seven. Rendile handled everything — I just had to show up and feel."</blockquote>
          <figcaption><strong>Amara O.</strong><span>London → Rwanda &amp; Uganda</span></figcaption>
        </figure>
        <figure class="review">
          <blockquote>"The Zanzibar retreat was sun, spice and sisterhood, exactly as promised. Not a single detail dropped — just space to breathe and women who get it."</blockquote>
          <figcaption><strong>Diana M.</strong><span>New York → Zanzibar Women's Retreat</span></figcaption>
        </figure>
      </div>

      <div class="reviews__dots" id="reviewsDots" aria-hidden="true"></div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="newsletter">
    <div class="container newsletter__inner reveal">
      <div>
        <h3>Travel notes for women, now and then</h3>
        <p>New retreat dates, early-bird places and quiet inspiration for women who travel. Never spam.</p>
      </div>
      <form class="newsletter__form" id="newsletterForm">
        <input type="email" placeholder="Enter your email" aria-label="Email address" required />
        <button class="btn btn--dark" type="submit">Subscribe</button>
      </form>
    </div>
  </section>

  <!-- Footer -->

</Base>

---
import Base from '../layouts/BaseLayout.astro';
---
<Base
  title={`Rendile Travels — Curated Journeys for Women in East Africa`}
  description={`Curated travel experiences for women exploring East Africa. Intimate, beautifully designed journeys across Kenya, Tanzania, Rwanda, Uganda and Zanzibar — by women, for women.`}
  ogTitle={`Rendile Travels — Where Every Path Tells a Story`}
  ogDescription={`Curated travel experiences for women exploring East Africa. Intimate journeys, designed by women, for women.`}
  ogType={`website`}
  ogImage={`assets/logo-orange.png`}
  credit={`Imagery &amp; film via Wikimedia Commons: balloon © Svein-Magne Tunli; Maasai woman © Ondřej Havelka; tree-climbing lion © Fanny Schertzer; mountain gorilla © Charles J. Sharp; hero film “Maasai people singing and dancing” © Bigvai Muhoti. Licensed under <a href="https://creativecommons.org/licenses/by/4.0" target="_blank" rel="license noopener">CC BY</a> / <a href="https://creativecommons.org/licenses/by-sa/4.0" target="_blank" rel="license noopener">CC BY-SA</a>.`}
  announce
>

<!-- Hero -->
  <section class="hero">
    <div class="hero__media" style="background-image:url('assets/img/hero-women.jpg')">
      <video class="hero__vid" id="heroVidA" muted playsinline preload="auto" aria-hidden="true"></video>
      <video class="hero__vid" id="heroVidB" muted playsinline preload="none" aria-hidden="true"></video>
    </div>
    <div class="hero__scrim"></div>
    <div class="container hero__content">
      <p class="eyebrow eyebrow--light reveal">Women's luxury travel · East Africa</p>
      <h1 class="hero__title reveal">Where Every Path<br/>Tells a Story</h1>
      <p class="hero__lead reveal">Curated travel experiences for women exploring East Africa.</p>
      <div class="hero__actions reveal">
        <a href="#destinations" class="btn btn--gold">Explore East Africa</a>
        <a href="#journeys" class="btn btn--ghost">Signature trips</a>
        <a href="custom-safaris.html" class="btn btn--ghost">Custom Safaris</a>
      </div>
      <ul class="hero__trust reveal">
        <li>Intimate groups of 8–12</li>
        <li>Designed by women, for women</li>
        <li>Hand-picked stays</li>
        <li>On-trip concierge</li>
      </ul>
    </div>
    <a href="#destinations" class="hero__scroll" aria-label="Scroll to explore">
      <span class="hero__scroll-text">Scroll to explore</span>
      <span class="hero__scroll-dot"></span>
    </a>
  </section>

  <!-- Destinations -->
  <section class="section section--cream destinations" id="destinations">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Destinations</p>
        <h2 class="section__title">Explore East Africa</h2>
      </div>

      <div class="dest__grid">
        <a class="dest reveal" href="kenya.html" style="background-image:url('assets/img/kenya.jpg');background-size:cover;background-position:center">
          <div class="dest__body">
            <h3>Kenya</h3>
            <p>The birthplace of safari</p>
          </div>
        </a>
        <a class="dest reveal" href="tanzania.html" style="background-image:url('assets/img/tanzania.jpg');background-size:cover;background-position:center">
          <div class="dest__body">
            <h3>Tanzania</h3>
            <p>Serengeti &amp; the Maasai</p>
          </div>
        </a>
        <a class="dest reveal" href="uganda.html" style="background-image:url('assets/img/uganda.jpg');background-size:cover;background-position:center">
          <div class="dest__body">
            <h3>Uganda</h3>
            <p>Tree-climbing lions</p>
          </div>
        </a>
        <a class="dest reveal" href="rwanda.html" style="background-image:url('assets/img/rwanda.jpg');background-size:cover;background-position:center">
          <div class="dest__body">
            <h3>Rwanda</h3>
            <p>The land of a thousand hills</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Upcoming Journeys -->
  <section class="section section--cream journeys" id="journeys">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Upcoming journeys</p>
        <h2 class="section__title">Signature Trips</h2>
        <p class="section__intro">Small-group departures. Reserve your spot.</p>
      </div>

      <div class="journeys__grid">
        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/trip-family.jpg')">
            <span class="journey__tag">Kenya · Family</span>
          </div>
          <div class="journey__body">
            <h3>Mummy and Me Safari</h3>
            <p class="journey__meta">5 days · Mothers &amp; children</p>
            <p>A carefully crafted family adventure where mothers and children bond over wildlife encounters, bush walks, and starlit stories.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$4,900</strong> <em>/ person</em></span>
              <a href="mummy-and-me-safari.html" class="link-arrow">Learn more →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/trip-lamu.jpg')">
            <span class="journey__tag">Lamu, Kenya · Wellness</span>
          </div>
          <div class="journey__body">
            <h3>Lamu Yoga Festival</h3>
            <p class="journey__meta">5 days · Women &amp; men · adults only</p>
            <p>Join Kenya's beloved Lamu Yoga &amp; Wellbeing Festival on the Swahili coast — five days of beachfront yoga, meditation and workshops, with dhow cruises, mangrove swims and Swahili feasts across the islands of Lamu and Manda.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$5,600</strong> <em>/ person</em></span>
              <a href="lamu-yoga-festival.html" class="link-arrow">Learn more →</a>
            </div>
          </div>
        </article>

        <article class="journey reveal">
          <div class="journey__media" style="background-image:url('assets/img/trip-zanzibar.jpg')">
            <span class="journey__tag">Zanzibar · Women-only</span>
          </div>
          <div class="journey__body">
            <h3>Zanzibar Women's Retreat</h3>
            <p class="journey__meta">7 days · Women-only</p>
            <p>A week of sun, spice, and sisterhood on Zanzibar's pristine beaches. Daily yoga, cooking classes, and sunset dhow cruises.</p>
            <div class="journey__foot">
              <span class="journey__price">from <strong>$6,200</strong> <em>/ person</em></span>
              <a href="zanzibar-womens-retreat.html" class="link-arrow">Learn more →</a>
            </div>
          </div>
        </article>
      </div>

      <div class="journeys__cta reveal">
        <a href="mailto:hello@rendiletravels.com" class="btn btn--gold">Explore all trips</a>
      </div>
    </div>
  </section>

  <!-- The Rendile Difference -->
  <section class="section pillars" id="difference">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Why travel with us</p>
        <h2 class="section__title">The Rendile Difference</h2>
        <p class="section__intro">Journeys designed by women, for women. Every detail considered, every path a story worth telling.</p>
      </div>

      <div class="pillars__grid">
        <article class="pillar reveal">
          <span class="pillar__num">01</span>
          <h3>Curated Itineraries</h3>
          <p>No cookie-cutter trips. Each experience is uniquely crafted around you — your pace, your passions, your comfort.</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__num">02</span>
          <h3>Authentic Connections</h3>
          <p>Meet local women, artisans, and change-makers along the way. Travel that opens doors, not just itineraries.</p>
        </article>
        <article class="pillar reveal">
          <span class="pillar__num">03</span>
          <h3>Intimate by Design</h3>
          <p>Small groups of 8–12, or fully private. Real connections, not crowds — and safety woven through every day.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Long weekends / short escapes -->
  <section class="section section--cream weekends" id="weekends">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Short on time?</p>
        <h2 class="section__title">Long weekends</h2>
        <p class="section__intro">Three days, one unforgettable escape. Fly-in getaways for when you can only slip away briefly — a weekend on safari, an hour with the gorillas, or barefoot on the Swahili coast.</p>
      </div>
      <div class="feat__grid">
        <a class="feat reveal" href="weekend-mara.html">
          <div class="feat__img" style="background-image:url('assets/img/kenya-cheetah.jpg')"></div>
          <div class="feat__body">
            <h3>A Weekend in the Mara</h3>
            <p>Fly in to the Maasai Mara for two nights of game drives in big-cat country. 3 days.</p>
            <div class="feat__foot">
              <span class="feat__price">from <strong>$1,490</strong></span>
              <span class="feat__view">View itinerary →</span>
            </div>
          </div>
        </a>

        <a class="feat reveal" href="gorillas-in-a-weekend.html">
          <div class="feat__img" style="background-image:url('assets/img/rw-volcanoes.jpg')"></div>
          <div class="feat__body">
            <h3>Gorillas in a Weekend</h3>
            <p>A fly-in trek to Rwanda's Volcanoes for a face-to-face hour with mountain gorillas. 3 days.</p>
            <div class="feat__foot">
              <span class="feat__price">from <strong>$2,400</strong></span>
              <span class="feat__view">View itinerary →</span>
            </div>
          </div>
        </a>

        <a class="feat reveal" href="swahili-coast-escape.html">
          <div class="feat__img" style="background-image:url('assets/img/lamu-hero.jpg')"></div>
          <div class="feat__body">
            <h3>Swahili Coast Escape</h3>
            <p>Barefoot days, dhow sails and fresh seafood on Kenya's Indian Ocean coast. 3 days.</p>
            <div class="feat__foot">
              <span class="feat__price">from <strong>$890</strong></span>
              <span class="feat__view">View itinerary →</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Add-on experiences / resident escapes -->
  <section class="section section--cream experiences" id="experiences">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Already in East Africa?</p>
        <h2 class="section__title">Off-the-beaten-path escapes</h2>
        <p class="section__intro">For those who already know the region — the experiences most travellers miss. Big-game fishing, kitesurfing, riding, camel treks and the wild frontier. Short, special, and often at resident rates.</p>
      </div>
      <div class="feat__grid">
        <a class="feat reveal" href="tuna-fishing-lamu.html">
          <div class="feat__img" style="background-image:url('assets/img/kenya-lamu.jpg')"></div>
          <div class="feat__body">
            <h3>Big-Game Fishing in Lamu</h3>
            <p>Sailfish &amp; tuna off the archipelago, then barefoot Swahili luxury. 3 days.</p>
            <div class="feat__foot">
              <span class="feat__price">from <strong>$1,650</strong></span>
              <span class="feat__view">View itinerary →</span>
            </div>
          </div>
        </a>

        <a class="feat reveal" href="kitesurfing-diani.html">
          <div class="feat__img" style="background-image:url('assets/img/diani-beach.jpg')"></div>
          <div class="feat__body">
            <h3>Kitesurfing in Diani</h3>
            <p>Catch the wind on Galu Beach, warm shallow water, certified instructors. 3 days.</p>
            <div class="feat__foot">
              <span class="feat__price">from <strong>$980</strong></span>
              <span class="feat__view">View itinerary →</span>
            </div>
          </div>
        </a>

        <a class="feat reveal" href="horseback-nanyuki.html">
          <div class="feat__img" style="background-image:url('assets/img/horse-safari.jpg')"></div>
          <div class="feat__body">
            <h3>Horseback Safari in Nanyuki</h3>
            <p>Ride the Laikipia plains with zebra and giraffe, Mount Kenya on the horizon. 3 days.</p>
            <div class="feat__foot">
              <span class="feat__price">from <strong>$1,750</strong></span>
              <span class="feat__view">View itinerary →</span>
            </div>
          </div>
        </a>

        <a class="feat reveal" href="camel-trek-northern.html">
          <div class="feat__img" style="background-image:url('assets/img/camel-trek.jpg')"></div>
          <div class="feat__body">
            <h3>Camel Trek in the Northern Frontier</h3>
            <p>Walk the wild north with Samburu guides, sleeping out under the stars. 3 days.</p>
            <div class="feat__foot">
              <span class="feat__price">from <strong>$1,550</strong></span>
              <span class="feat__view">View itinerary →</span>
            </div>
          </div>
        </a>

        <a class="feat reveal" href="northern-kenya-desert.html">
          <div class="feat__img" style="background-image:url('assets/img/kenya-samburu.jpg')"></div>
          <div class="feat__body">
            <h3>Northern Kenya Desert Safari</h3>
            <p>To the edge of the map — jade Lake Turkana and the shimmering Chalbi Desert. 4 days.</p>
            <div class="feat__foot">
              <span class="feat__price">from <strong>$2,950</strong></span>
              <span class="feat__view">View itinerary →</span>
            </div>
          </div>
        </a>

        <a class="feat reveal" href="balloon-mara.html">
          <div class="feat__img" style="background-image:url('assets/img/kenya.jpg')"></div>
          <div class="feat__body">
            <h3>Hot-Air Balloon over the Mara</h3>
            <p>Drift over the plains at dawn, then a champagne bush breakfast. 2 days.</p>
            <div class="feat__foot">
              <span class="feat__price">from <strong>$1,290</strong></span>
              <span class="feat__view">View itinerary →</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Stories from the Road -->
  <section class="section reviews" id="reviews">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Stories from the road</p>
        <h2 class="section__title">Loved by the women who travel with us.</h2>
        <div class="stars" aria-label="5 out of 5 stars">★★★★★ <span>5.0 · from every traveller, so far</span></div>
      </div>

      <div class="reviews__track" id="reviewsTrack">
        <figure class="review is-active">
          <blockquote>"I travelled solo for the first time at 54 and never once felt alone or unsafe. Every stay, every guide, every sunrise was thought through. I came home a different woman."</blockquote>
          <figcaption><strong>Wanjiru K.</strong><span>Nairobi → Maasai Mara &amp; Serengeti</span></figcaption>
        </figure>
        <figure class="review">
          <blockquote>"The women-only departure was the trip of my life. Twelve strangers on day one, friends for life by day seven. Rendile handled everything — I just had to show up and feel."</blockquote>
          <figcaption><strong>Amara O.</strong><span>London → Rwanda &amp; Uganda</span></figcaption>
        </figure>
        <figure class="review">
          <blockquote>"The Zanzibar retreat was sun, spice and sisterhood, exactly as promised. Not a single detail dropped — just space to breathe and women who get it."</blockquote>
          <figcaption><strong>Diana M.</strong><span>New York → Zanzibar Women's Retreat</span></figcaption>
        </figure>
      </div>

      <div class="reviews__dots" id="reviewsDots" aria-hidden="true"></div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="newsletter">
    <div class="container newsletter__inner reveal">
      <div>
        <h3>Travel notes for women, now and then</h3>
        <p>Curated travel experiences for women exploring East Africa — departure dates, secret stays and quiet inspiration. Never spam.</p>
      </div>
      <form class="newsletter__form" id="newsletterForm">
        <input type="email" placeholder="Enter your email" aria-label="Email address" required />
        <button class="btn btn--dark" type="submit">Subscribe</button>
      </form>
    </div>
  </section>

  <!-- Footer -->

</Base>

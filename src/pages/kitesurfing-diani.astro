  ogTitle={`Kitesurfing in Diani | 3 Day Galu Beach Escape | Rendile Travels`}
  ogDescription={`Learn to kitesurf on Diani's Galu Beach during kite season. 3 days from $980.`}
  ogType={`website`}
  ogImage={`assets/img/diani-beach.jpg`}
  canonical={`https://rendiletravels.com/kitesurfing-diani.html`}
  jsonld={`{"@context":"https://schema.org","@type":"TouristTrip","name":"Kitesurfing in Diani — 3-Day Galu Beach Escape","description":"A 3-day kitesurfing escape on Diani's Galu Beach during kite season.","image":"https://rendiletravels.com/assets/img/diani-beach.jpg","provider":{"@type":"Organization","name":"Rendile Travels"},"offers":{"@type":"Offer","price":"980","priceCurrency":"USD"}}`}

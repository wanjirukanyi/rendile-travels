<section class="page-hero">
    <div class="page-hero__media" style="background-image:url('assets/img/kenya-hero.jpg')"></div>
    <div class="page-hero__scrim"></div>
    <div class="container page-hero__content">
      <p class="eyebrow eyebrow--light reveal">Good to know</p>

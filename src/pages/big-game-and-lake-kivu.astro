<Base
  title={`Big Game & Lake Kivu | 6 Day Akagera Safari & Lake Itinerary | Rendile Travels`}
  description={`A 6 day Rwanda journey, a Big Five safari across restored Akagera National Park, then restful days on the shores of Lake Kivu. Day by day itinerary and prices from $6,200.`}
  ogTitle={`Big Game & Lake Kivu | 6 Day Akagera Safari & Lake Itinerary | Rendile Travels`}
  ogDescription={`A Big Five safari in Akagera then the calm shores of Lake Kivu, a 6 day Rwanda journey from $6,200.`}
  ogType={`website`}
  ogImage={`assets/img/rw-akagera.jpg`}
  canonical={`https://rendiletravels.com/big-game-and-lake-kivu.html`}
  jsonld={`{"@context":"https://schema.org","@type":"TouristTrip","name":"Big Game & Lake Kivu — 6-Day Akagera Safari & Lake Itinerary","description":"A 6-day Rwanda journey with a Big Five safari in Akagera and restful days on Lake Kivu.","image":"https://rendiletravels.com/assets/img/rw-akagera.jpg","provider":{"@type":"Organization","name":"Rendile Travels"},"offers":{"@type":"Offer","price":"6200","priceCurrency":"USD"}}`}

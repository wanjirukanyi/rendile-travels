      <div class="related__grid reveal">
        <a class="feat" href="rwanda-in-full.html"><div class="feat__img" style="background-image:url('assets/img/rw-thousandhills.jpg')"></div><div class="feat__body"><h3>Rwanda in Full</h3><p>10 days · the whole country.</p></div></a>
        <a class="feat" href="gorillas-of-the-volcanoes.html"><div class="feat__img" style="background-image:url('assets/img/rw-volcanoes.jpg')"></div><div class="feat__body"><h3>Gorillas of the Volcanoes</h3><p>4 days · a focused gorilla trek.</p></div></a>
        <a class="feat" href="rwanda.html"><div class="feat__img" style="background-image:url('assets/img/rw-kigali.jpg')"></div><div class="feat__body"><h3>All Rwanda itineraries</h3><p>Browse every Rwanda journey.</p></div></a>
      </div>
    </div>
  </section>

